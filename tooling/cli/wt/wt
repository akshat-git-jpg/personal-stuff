#!/bin/bash
set -euo pipefail

# A lease is held from `wt get` until someone calls `wt return`. There is no
# owner-liveness signal by design (lease-only model, see README) — so a holder
# that dies between the two NEVER gives its slot back, and `wt get` treats the
# stale lease as live forever because its only test is "does the lease file
# exist". On 2026-08-22 four of eight slots were held by boss crews whose PRs
# had been merged or closed weeks earlier (one for 25 days), and the pool was
# one lease away from `ERROR: pool full` starving every future dispatch.
#
# `reap` is the safety net for that. It answers only the two questions this
# tool can answer on its own — how OLD is the lease, and is the worktree
# CLEAN — and refuses to discard uncommitted work. Whether a holder is
# actually still alive is caller-specific knowledge (boss maps `boss-<pr>` to a
# GitHub PR state and sweeps on that in boss-session-start.sh); wt deliberately
# does not guess at it.
DEFAULT_TTL_HOURS=24

# Bounded wait for the pool lock. Pre-2026-08-23 `lock_pool` was an unbounded
# `until mkdir` spin released only by an EXIT trap — and SIGKILL skips traps, so a
# single killed `wt` wedged EVERY later `wt` call forever, with no timeout and no
# message. There is no diagnostic that leads anyone to the lock dir, so the fix is
# to break a provably-dead lock, bound the wait, and fail loudly.
LOCK_WAIT_SECS=30

function usage() {
  echo "Usage: wt <command> [options]" >&2
  echo "Commands:" >&2
  echo "  get    [--repo <path>] [--holder <label>]" >&2
  echo "  return <worktree-path> [--force-dirty] [--holder <label>]
         --holder makes the return REFUSE if the lease names a different holder
         (a stale path must never clobber a slot someone else now owns)." >&2
  echo "  status [--repo <path>]" >&2
  echo "  prune  [--repo <path>] [--yes]" >&2
  echo "  reap   [--repo <path>] [--ttl-hours <n>] [--yes] [--force-dirty]" >&2
  echo "         free leases older than the TTL (default $DEFAULT_TTL_HOURS h) whose worktree is CLEAN." >&2
  echo "  release --holder <label> [--repo <path>] [--force-dirty]" >&2
  echo "         free the slot held by <label>. For a caller that KNOWS the holder is done" >&2
  echo "         (boss maps boss-<pr> to a terminal PR state); no TTL wait." >&2
  exit 2
}

if [ $# -eq 0 ]; then
  usage
fi

CMD=$1
shift

REPO="."
HOLDER="unknown"
PRUNE_YES=0
TARGET_WT=""
RETURN_HOLDER=""
TTL_HOURS="$DEFAULT_TTL_HOURS"
FORCE_DIRTY=0

# Parse args
case "$CMD" in
  get|status|prune|reap|release)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --repo) REPO="$2"; shift 2 ;;
        --holder) HOLDER="$2"; shift 2 ;;
        --yes) PRUNE_YES=1; shift ;;
        --ttl-hours) TTL_HOURS="$2"; shift 2 ;;
        --force-dirty) FORCE_DIRTY=1; shift ;;
        *) usage ;;
      esac
    done
    ;;
  return)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --force-dirty) FORCE_DIRTY=1; shift ;;
        --holder) RETURN_HOLDER="$2"; shift 2 ;;
        -*) usage ;;
        *) [ -n "$TARGET_WT" ] && usage; TARGET_WT="$1"; shift ;;
      esac
    done
    [ -n "$TARGET_WT" ] || usage
    ;;
  *)
    usage
    ;;
esac

# Resolve repo
REPO=$(cd "$REPO" && pwd) || exit 1
if ! git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "ERROR: $REPO is not a git repository" >&2
  exit 1
fi

REPO_TOPLEVEL=$(git -C "$REPO" rev-parse --show-toplevel)
REPO_BASENAME=$(basename "$REPO_TOPLEVEL")
HASH8=$(echo -n "$REPO_TOPLEVEL" | shasum -a 256 | cut -c 1-8)
POOL="$HOME/kb-scratch/worktrees/$REPO_BASENAME-$HASH8"
MAX_TREES=8

# Locking mechanism
LOCK_DIR="$POOL/.lock.d"

function lock_pool() {
  mkdir -p "$POOL"
  local iters=0 max_iters=$((LOCK_WAIT_SECS * 5)) owner_pid now mtime
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    owner_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
    # A recorded holder that no longer exists was killed before its trap ran.
    if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
      echo "wt: breaking stale pool lock (holder pid $owner_pid is gone)" >&2
      rm -rf "$LOCK_DIR"; continue
    fi
    # No pid file at all: either a lock created before this fix, or a holder killed
    # between `mkdir` and the pid write. Break it on age alone.
    if [ -z "$owner_pid" ]; then
      now=$(date +%s)
      mtime=$(stat -f %m "$LOCK_DIR" 2>/dev/null || echo "$now")
      if [ $((now - mtime)) -ge "$LOCK_WAIT_SECS" ]; then
        echo "wt: breaking stale pool lock (no pid recorded, ${LOCK_WAIT_SECS}s+ old)" >&2
        rm -rf "$LOCK_DIR"; continue
      fi
    fi
    if [ "$iters" -ge "$max_iters" ]; then
      echo "ERROR: pool lock held >${LOCK_WAIT_SECS}s by live pid ${owner_pid:-unknown}" >&2
      echo "  Not breaking a lock whose holder is alive. Inspect that process, or if it is" >&2
      echo "  wedged, remove: $LOCK_DIR" >&2
      exit 1
    fi
    sleep 0.2; iters=$((iters + 1))
  done
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
}

# Only remove a lock this process actually owns. The EXIT trap fires on every exit
# path, including ones where lock_pool was never called or gave up — a blind rmdir
# there lets a process that never held the lock free someone else's.
function unlock_pool() {
  local owner_pid
  owner_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
  if [ -n "$owner_pid" ] && [ "$owner_pid" != "$$" ]; then
    return 0
  fi
  rm -rf "$LOCK_DIR" 2>/dev/null || true
}

trap unlock_pool EXIT

function get_default_branch() {
  local ref
  if ref=$(git -C "$REPO_TOPLEVEL" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null); then
    echo "${ref#refs/remotes/origin/}"
  else
    echo "main"
  fi
}

function reset_worktree() {
  local wt_path=$1
  local def_branch=$(get_default_branch)
  local target_ref="origin/$def_branch"
  
  if ! git -C "$REPO_TOPLEVEL" show-ref --verify --quiet "refs/remotes/origin/$def_branch"; then
    target_ref="$def_branch"
  fi

  git -C "$wt_path" checkout --detach "$target_ref" >&2
  git -C "$wt_path" reset --hard "$target_ref" >&2
  git -C "$wt_path" clean -fd >&2
}

# Lease age in whole hours, from the lease file's mtime. mtime rather than the
# `leased_at` line inside the file: `wt status` already reports mtime, so the
# two can never disagree, and a hand-edited or truncated lease file still ages.
function lease_age_hours() {
  local lease_file=$1 now mtime
  [ -f "$lease_file" ] || { echo 0; return; }
  now=$(date +%s)
  mtime=$(stat -f %m "$lease_file" 2>/dev/null || echo "$now")
  echo $(( (now - mtime) / 3600 ))
}

function wt_is_clean() {
  local wt_path=$1
  [ -z "$(git -C "$wt_path" status --porcelain --untracked-files=all 2>/dev/null)" ]
}

# Free one slot. Refuses a dirty worktree unless --force-dirty: a leaked lease
# costs a slot, but discarding a crew's uncommitted implementation costs the
# work itself, and a mid-flight kill leaving a complete-but-uncommitted tree is
# a KNOWN boss failure mode (decisions.md 2026-08-02) — exactly the case that
# must survive a reap. Caller holds the pool lock.
function reap_slot() {
  local i=$1 wt_path=$2 lease_file=$3 holder=$4 age=$5
  if ! wt_is_clean "$wt_path" && [ "$FORCE_DIRTY" -ne 1 ]; then
    echo "wt: slot $i STALE but DIRTY — NOT reaped (holder=$holder, ${age}h old)" >&2
    echo "    uncommitted work lives at $wt_path — salvage it, then: wt return $wt_path" >&2
    echo "    (or re-run with --force-dirty to discard it)" >&2
    return 1
  fi
  rm -f "$lease_file"
  reset_worktree "$wt_path"
  echo "wt: reaped slot $i (holder=$holder, ${age}h old)" >&2
  return 0
}

function run_bootstrap() {
  local wt_path=$1
  local hook_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bootstrap.d/$REPO_BASENAME.sh"
  if [ -x "$hook_script" ]; then
    (export WT_MAIN_CHECKOUT="$REPO_TOPLEVEL"; cd "$wt_path" && "$hook_script") || echo "WARNING: bootstrap hook failed" >&2
  fi
}

case "$CMD" in
  get)
    git -C "$REPO_TOPLEVEL" fetch origin >&2 || echo "WARNING: fetch failed" >&2
    
    lock_pool
    
    allocated_path=""
    for i in $(seq 1 $MAX_TREES); do
      n_dir="$POOL/$i"
      wt_path="$n_dir/$REPO_BASENAME"
      lease_file="$POOL/$i.lease"
      
      if [ -d "$wt_path" ]; then
        if [ ! -f "$lease_file" ]; then
          if ! wt_is_clean "$wt_path"; then
            if [ "$FORCE_DIRTY" -ne 1 ]; then
              echo "wt: slot $i unleased but DIRTY — skipped, NOT reclaimed" >&2
              echo "  Uncommitted work is still there: $wt_path" >&2
              echo "  Rescue it, or discard it with: wt get --force-dirty" >&2
              continue
            fi
            echo "wt: reclaimed dirty orphaned slot $wt_path (--force-dirty: uncommitted work discarded)" >&2
          fi
          reset_worktree "$wt_path"
          allocated_path="$wt_path"
          allocated_lease="$lease_file"
          break
        fi
      else
        # Not created yet, create it
        def_branch=$(get_default_branch)
        target_ref="origin/$def_branch"
        if ! git -C "$REPO_TOPLEVEL" show-ref --verify --quiet "refs/remotes/origin/$def_branch"; then
          target_ref="$def_branch"
        fi
        
        mkdir -p "$n_dir"
        git -C "$REPO_TOPLEVEL" worktree add --detach "$wt_path" "$target_ref" >&2
        allocated_path="$wt_path"
        allocated_lease="$lease_file"
        break
      fi
    done
    
    # Pool full: before failing, reclaim any lease that is provably abandoned
    # (older than the TTL and clean). Without this a single leaked lease is
    # permanent and the pool only ever shrinks — four had leaked by 2026-08-22,
    # each one silently removing a dispatch slot for good.
    if [ -z "$allocated_path" ]; then
      for i in $(seq 1 $MAX_TREES); do
        wt_path="$POOL/$i/$REPO_BASENAME"
        lease_file="$POOL/$i.lease"
        [ -d "$wt_path" ] && [ -f "$lease_file" ] || continue
        age=$(lease_age_hours "$lease_file")
        [ "$age" -ge "$TTL_HOURS" ] || continue
        holder=$(grep "^holder=" "$lease_file" 2>/dev/null | cut -d= -f2 || echo unknown)
        if reap_slot "$i" "$wt_path" "$lease_file" "$holder" "$age"; then
          allocated_path="$wt_path"
          allocated_lease="$lease_file"
          break
        fi
      done
    fi

    if [ -z "$allocated_path" ]; then
      echo "ERROR: pool full ($MAX_TREES) and no lease is reapable" >&2
      echo "  Every slot is leased and younger than ${TTL_HOURS}h, or stale but DIRTY." >&2
      echo "  Inspect with: wt status   Free abandoned ones with: wt reap --yes" >&2
      unlock_pool
      exit 1
    fi
    
    # Write lease
    echo "holder=$HOLDER" > "$allocated_lease"
    echo "leased_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")" >> "$allocated_lease"
    
    run_bootstrap "$allocated_path"
    
    unlock_pool
    # Print the path on stdout
    echo "$allocated_path"
    ;;
    
  return)
    wt_path=$(cd "$TARGET_WT" 2>/dev/null && pwd) || { echo "ERROR: invalid path" >&2; exit 2; }
    
    if [[ "$wt_path" != "$POOL/"*"/$REPO_BASENAME" ]]; then
      echo "ERROR: not a wt-managed worktree" >&2
      exit 2
    fi
    
    # Check if dirty or unpushed
    if [ -n "$(git -C "$wt_path" log --oneline @{u}..HEAD 2>/dev/null)" ]; then
      echo "WARNING: worktree has unpushed commits" >&2
    fi
    if ! wt_is_clean "$wt_path"; then
      if [ "$FORCE_DIRTY" -ne 1 ]; then
        echo "ERROR: worktree is DIRTY — NOT returned" >&2
        echo "  A mid-flight kill routinely leaves a complete-but-uncommitted implementation;" >&2
        echo "  losing a slot is far cheaper than losing that work (decisions.md 2026-08-02)." >&2
        echo "  $wt_path" >&2
        echo "  Rescue it, or discard it with: wt return --force-dirty $wt_path" >&2
        exit 1
      fi
      echo "wt: returning a DIRTY worktree (--force-dirty: uncommitted work discarded)" >&2
    fi
    
    n_dir=$(dirname "$wt_path")
    i=$(basename "$n_dir")
    lease_file="$POOL/$i.lease"

    # Custody check. `wt return <path>` freed AND hard-reset a slot no matter who
    # held the lease, so a caller holding a STALE path clobbered a slot that had
    # since been re-leased to someone else. On 2026-08-23 boss-merge for PR#195
    # returned slot 1 from PR#195's old meta; slot 1 was by then leased to PR#197,
    # whose agy crew was still working in it — the lease was deleted and the
    # worktree detached under a live crew. The dirty guard below capped the damage
    # at a stolen slot that day, but the next step is two crews in one directory.
    # A caller that knows its holder passes it and is refused when the lease
    # names someone else. Callers that pass nothing keep the old behaviour.
    if [ -n "$RETURN_HOLDER" ] && [ -f "$lease_file" ]; then
      cur_holder=$(grep "^holder=" "$lease_file" | cut -d= -f2)
      if [ "$cur_holder" != "$RETURN_HOLDER" ]; then
        echo "ERROR: slot $i is leased to '$cur_holder', not '$RETURN_HOLDER' — NOT returned" >&2
        echo "  The path you passed is stale; that slot belongs to someone else now." >&2
        exit 3
      fi
    fi

    lock_pool
    rm -f "$lease_file"
    reset_worktree "$wt_path"
    unlock_pool
    ;;
    
  status)
    lock_pool
    printf "%-5s %-10s %-15s %-6s %s\n" "N" "STATE" "HOLDER" "HOURS" "AGE"
    stale_seen=0
    for i in $(seq 1 $MAX_TREES); do
      n_dir="$POOL/$i"
      wt_path="$n_dir/$REPO_BASENAME"
      lease_file="$POOL/$i.lease"

      if [ -d "$wt_path" ]; then
        if [ -f "$lease_file" ]; then
          holder=$(grep "^holder=" "$lease_file" | cut -d= -f2)
          age=$(lease_age_hours "$lease_file")
          state="leased"
          # A leak is invisible if it just reads as "leased" — say so out loud.
          if [ "$age" -ge "$TTL_HOURS" ]; then
            stale_seen=1
            if wt_is_clean "$wt_path"; then state="STALE"; else state="STALE/DIRTY"; fi
          fi
          printf "%-5s %-10s %-15s %-6s %s\n" "$i" "$state" "$holder" "$age" "$(stat -f "%Sm" -t "%Y-%m-%d %H:%M:%S" "$lease_file")"
        else
          if [ -n "$(git -C "$wt_path" status --porcelain --untracked-files=all 2>/dev/null)" ]; then
            printf "%-5s %-10s %-15s %-6s %s\n" "$i" "dirty" "-" "-" "-"
          else
            printf "%-5s %-10s %-15s %-6s %s\n" "$i" "free" "-" "-" "-"
          fi
        fi
      fi
    done
    if [ "$stale_seen" -eq 1 ]; then
      echo "" >&2
      echo "STALE = leased >= ${TTL_HOURS}h. Free the clean ones: wt reap --yes" >&2
      echo "STALE/DIRTY holds uncommitted work — salvage it before freeing." >&2
    fi
    unlock_pool
    ;;
    
  release)
    # Targeted, immediate, no TTL: the caller has positively established that this
    # holder is finished, which is knowledge wt cannot derive (boss checks the PR
    # state). Still refuses a dirty worktree without --force-dirty — "the holder is
    # gone" and "its work was committed" are different claims, and a mid-flight kill
    # routinely leaves a complete implementation uncommitted (decisions.md 2026-08-02).
    if [ "$HOLDER" = "unknown" ]; then
      echo "ERROR: release needs --holder <label>" >&2
      exit 2
    fi
    lock_pool
    released=0
    for i in $(seq 1 $MAX_TREES); do
      wt_path="$POOL/$i/$REPO_BASENAME"
      lease_file="$POOL/$i.lease"
      [ -d "$wt_path" ] && [ -f "$lease_file" ] || continue
      h=$(grep "^holder=" "$lease_file" 2>/dev/null | cut -d= -f2 || echo "")
      [ "$h" = "$HOLDER" ] || continue
      age=$(lease_age_hours "$lease_file")
      if reap_slot "$i" "$wt_path" "$lease_file" "$h" "$age"; then
        released=$((released + 1))
      fi
    done
    if [ "$released" -eq 0 ]; then
      echo "wt: no slot released for holder=$HOLDER" >&2
      unlock_pool
      exit 1
    fi
    unlock_pool
    ;;

  reap)
    # Dry-run by default (like prune) — freeing a slot resets the worktree, so
    # the destructive form is opt-in.
    lock_pool
    reaped=0; blocked=0; candidates=0
    for i in $(seq 1 $MAX_TREES); do
      wt_path="$POOL/$i/$REPO_BASENAME"
      lease_file="$POOL/$i.lease"
      [ -d "$wt_path" ] && [ -f "$lease_file" ] || continue
      age=$(lease_age_hours "$lease_file")
      [ "$age" -ge "$TTL_HOURS" ] || continue
      candidates=$((candidates + 1))
      holder=$(grep "^holder=" "$lease_file" 2>/dev/null | cut -d= -f2 || echo unknown)
      if [ "$PRUNE_YES" -ne 1 ]; then
        if wt_is_clean "$wt_path"; then
          echo "Would reap slot $i (holder=$holder, ${age}h old, clean)" >&2
        else
          echo "Would SKIP slot $i (holder=$holder, ${age}h old, DIRTY — holds uncommitted work)" >&2
        fi
        continue
      fi
      if reap_slot "$i" "$wt_path" "$lease_file" "$holder" "$age"; then
        reaped=$((reaped + 1))
      else
        blocked=$((blocked + 1))
      fi
    done
    if [ "$candidates" -eq 0 ]; then
      echo "wt: nothing to reap (no lease is >= ${TTL_HOURS}h old)" >&2
    elif [ "$PRUNE_YES" -eq 1 ]; then
      echo "wt: reaped $reaped, skipped $blocked (dirty)" >&2
    else
      echo "wt: $candidates stale lease(s); re-run with --yes to free the clean ones" >&2
    fi
    unlock_pool
    ;;

  prune)
    lock_pool
    for i in $(seq 1 $MAX_TREES); do
      n_dir="$POOL/$i"
      wt_path="$n_dir/$REPO_BASENAME"
      lease_file="$POOL/$i.lease"
      
      if [ -d "$wt_path" ]; then
        if [ ! -f "$lease_file" ]; then
          if [ -z "$(git -C "$wt_path" status --porcelain --untracked-files=all 2>/dev/null)" ]; then
            if [ "$PRUNE_YES" -eq 1 ]; then
              git -C "$REPO_TOPLEVEL" worktree remove "$wt_path" >&2
              rm -rf "$n_dir"
              echo "Pruned $wt_path" >&2
            else
              echo "Would prune $wt_path (free+clean)" >&2
            fi
          fi
        fi
      fi
    done
    unlock_pool
    ;;
esac
