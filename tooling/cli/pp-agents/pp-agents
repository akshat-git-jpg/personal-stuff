#!/usr/bin/env python3
"""pp-agents - the agents view, grouped by tag, without patching Claude Code.

Claude Code ships session tags (it calls them groups) but the agents view
hardcodes its gate to false. `pp-claude-tags` used to flip that byte; 2.1.246
changed the build so the executed code no longer comes from the text we patched,
and the flip became silently cosmetic - the byte read "unlocked" while the
feature stayed off. That failure mode is unfixable from outside and will recur
on any release, so this replaces the approach instead of chasing it.

Nothing here patches, signs or inspects the binary. It reads the same on-disk
session records Claude Code writes, and it acts only through published commands:

    claude attach <id>      open a session in this terminal
    claude logs <id>        dump recent output
    claude stop <id>        stop a session
    claude --bg "<prompt>"  dispatch a new background session

An update can therefore never break this the way it broke the patch. If the
record format ever moves, the loader says so out loud instead of showing an
empty list.

Two things the built-in view cannot do come free here: both accounts (work and
personal) appear in one list, and the tag is the primary grouping.

Inside a session `shift+left` brings you back here, instantly. It is swallowed
before Claude Code ever sees it, so nothing has to be guessed from the screen
and the plain left arrow keeps working as an ordinary cursor key.

    kbc                       # the view (`pp-agents` is the same program)
    kbc --list                # one line per session, for scripts
    kbc --dump                # exactly what the view would draw, as plain text
    kbc --doctor              # check what it can read and act with
"""
import curses
import errno
import fcntl
import json
import os
import pty
import select
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import termios
import time
import tty

def _accounts_from_env():
    """`PP_AGENTS_ACCOUNTS=work=/tmp/a:personal=/tmp/b` overrides the real stores.

    This exists so the tests can drive the whole program - including the screen -
    against fixture directories, instead of reading the live session store. A
    view that is only ever tested by hand is how the last approach shipped a
    silent regression.
    """
    raw = os.environ.get("PP_AGENTS_ACCOUNTS")
    if not raw:
        return None
    out = []
    for part in raw.split(":"):
        if "=" in part:
            name, _, path = part.partition("=")
            out.append((name, os.path.expanduser(path)))
    return out or None


ACCOUNTS = _accounts_from_env() or [
    ("work", os.path.expanduser("~/.claude-work")),
    ("personal", os.path.expanduser("~/.claude-personal")),
]
PIN_STORE = os.path.expanduser(
    os.environ.get("PP_AGENTS_PINS", "~/.cache/pp-agents/pins.json"))
UNTAGGED = "Ungrouped"

# state.json's `state`, mapped to the words the built-in view uses, and the
# order they sort in: what is waiting on you first, what is finished last.
STATE_LABEL = {
    "blocked": "Needs input",
    "working": "Working",
    "done": "Done",
    "idle": "Idle",
    "error": "Error",
}
STATE_RANK = {"blocked": 0, "error": 1, "working": 2, "idle": 3, "done": 4}
GROUP_MODES = ("tag", "folder", "state")


# ---------------------------------------------------------------- loading

def account_dirs():
    """The config dirs that actually exist, newest-relevant first."""
    return [(name, path) for name, path in ACCOUNTS if os.path.isdir(os.path.join(path, "jobs"))]


def read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def load_jobs(accounts=None):
    """Every session Claude Code has recorded, as plain dicts.

    Reads `jobs/<short>/state.json` - the same record the built-in view renders
    - plus `jobs/<short>/group`, which is Claude Code's own tag file. Writing
    that file is what `ctrl+e` does, so a tag set here shows up there too if the
    feature is ever ungated, and vice versa. Nothing else is written into a job
    directory.
    """
    accounts = accounts if accounts is not None else account_dirs()
    jobs = []
    for account, root in accounts:
        jobs_dir = os.path.join(root, "jobs")
        try:
            shorts = os.listdir(jobs_dir)
        except OSError:
            continue
        for short in shorts:
            jdir = os.path.join(jobs_dir, short)
            st = read_json(os.path.join(jdir, "state.json"))
            if not isinstance(st, dict):
                continue  # an empty or half-written record, not an error
            tag = None
            try:
                with open(os.path.join(jdir, "group")) as fh:
                    tag = fh.read().strip() or None
            except OSError:
                pass
            jobs.append({
                "short": short,
                "account": account,
                "config_dir": root,
                "dir": jdir,
                "tag": tag,
                "name": display_name(st) or short,
                "detail": (st.get("detail") or st.get("needs") or "").replace("\n", " ").strip(),
                "state": (st.get("state") or "").lower(),
                "cwd": st.get("cwd") or st.get("originCwd") or "",
                "updated": st.get("updatedAt") or st.get("createdAt") or "",
                "tokens": st.get("tokens") or 0,
                "session_id": st.get("sessionId") or "",
            })
    return jobs


NO_TASK_YET = "awaiting task description"


def display_name(state):
    """The label for a row: the generated summary, unless there is nothing behind it.

    `name` is written the moment a session is dispatched, so for a one-line prompt
    it is a guess made from almost no information - `test1` came back as
    `onboarding empty state message`. While the session is still asking for its
    task there is no work to summarise, so the prompt you typed is the only honest
    label. After that the summary is the better one and wins again.
    """
    name = (state.get("name") or "").strip()
    intent = (state.get("intent") or "").strip()
    detail = (state.get("detail") or "").strip().lower()
    if intent and (not name or detail == NO_TASK_YET):
        return intent
    return name or intent


def load_pins():
    data = read_json(PIN_STORE)
    return set(data.get("pins", [])) if isinstance(data, dict) else set()


def save_pins(pins):
    os.makedirs(os.path.dirname(PIN_STORE), exist_ok=True)
    tmp = PIN_STORE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump({"pins": sorted(pins)}, fh)
    os.replace(tmp, PIN_STORE)


# ---------------------------------------------------------------- tagging

def write_tag(job, tag):
    """Set or clear a session's tag, in Claude Code's own `group` file.

    An empty tag removes the file rather than leaving a blank one, because the
    built-in view treats a present-but-empty file as a tag named "".
    """
    path = os.path.join(job["dir"], "group")
    tag = (tag or "").strip()
    if not tag:
        try:
            os.remove(path)
        except OSError:
            pass
        job["tag"] = None
        return None
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(tag + "\n")
    os.replace(tmp, path)
    job["tag"] = tag
    return tag


LIVE_STATES = ("working", "blocked")


def delete_record(job):
    """Remove a session's record directory. The LAST resort, not the first.

    `claude rm <id>` is the real delete and is what `act_delete` calls: it tells
    the daemon, which owns the session list. Removing the directory behind the
    daemon's back does not work - it rewrote both probe records minutes after they
    were deleted this way - so this is only used to tidy a directory that survives
    a successful `rm`.

    The path is re-derived from the account root and checked against the job's
    own short id first, so a malformed record can never turn this into a delete
    of something else.
    """
    root = os.path.realpath(os.path.join(job["config_dir"], "jobs"))
    target = os.path.realpath(job["dir"])
    if os.path.dirname(target) != root or os.path.basename(target) != job["short"]:
        raise ValueError(f"refusing to delete {target}: not a session record")
    shutil.rmtree(target)


SHORT_ID = re.compile(r"\b([0-9a-f]{8})\b")


def run_claude(cmd, cwd=None, env=None, timeout=45.0):
    """Run a `claude` subcommand and return its combined output.

    Output goes to a temp FILE, never a pipe. `claude --bg` spawns a
    `claude daemon run` child that outlives the command, and a pipe is only at
    EOF once every holder closes it - so `capture_output=True` waits for the
    daemon, i.e. forever, freezing this view mid-keystroke while the session it
    started runs happily in the background. A file has no such handshake.

    stdin is closed for the same class of reason: this view holds the terminal in
    raw mode, and a child must never be able to read the keys meant for it.
    """
    with tempfile.TemporaryFile("w+") as fh:
        try:
            subprocess.run(cmd, cwd=cwd or None, env=env,
                           stdin=subprocess.DEVNULL, stdout=fh,
                           stderr=subprocess.STDOUT,
                           start_new_session=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            fh.seek(0)
            return (fh.read() + f"\ntimed out after {timeout:.0f}s").strip()
        except OSError as exc:
            return f"could not run {cmd[0]}: {exc}"
        fh.seek(0)
        return fh.read().strip()


def start_claude(cmd, cwd=None, env=None):
    """Launch a `claude` subcommand and DO NOT wait for it. Returns (proc, log path).

    Waiting is the thing being avoided. A dispatch that blocks the key handler
    freezes the whole view, and a frozen curses program looks exactly like a
    working one showing a stale frame - which is how a dead `n` key went
    undiagnosed for a day. Output goes to a file the caller can read afterwards,
    and the child gets its own session and no stdin, so it can neither read the
    keys meant for this view nor die with it.
    """
    fh = tempfile.NamedTemporaryFile("w+", prefix="pp-agents-dispatch-",
                                     suffix=".log", delete=False)
    try:
        proc = subprocess.Popen(cmd, cwd=cwd or None, env=env,
                                stdin=subprocess.DEVNULL, stdout=fh,
                                stderr=subprocess.STDOUT, start_new_session=True)
    except OSError as exc:
        fh.write(f"could not run {cmd[0]}: {exc}\n")
        fh.close()
        return None, fh.name
    fh.close()
    return proc, fh.name


def last_line(path):
    """The last non-empty line of a log file, for the status bar."""
    try:
        with open(path) as fh:
            lines = [l.strip() for l in fh if l.strip()]
    except OSError:
        return ""
    return lines[-1] if lines else ""


def dispatched_id(text):
    """The short id `claude --bg` reported, or None.

    It prints `backgrounded · <id>` followed by four hint lines, so the id has to
    be read out rather than inferred from the last line of output - which is what
    the status bar used to show.
    """
    plain = re.sub(r"\x1b\[[0-9;]*m", "", text)
    for line in plain.splitlines():
        if "backgrounded" in line:
            found = SHORT_ID.search(line)
            if found:
                return found.group(1)
    found = SHORT_ID.search(plain)
    return found.group(1) if found else None


def record_exists(short, accounts=None):
    """True once some account holds a readable `state.json` for `short`."""
    for _name, root in (accounts if accounts is not None else account_dirs()):
        if os.path.isfile(os.path.join(root, "jobs", short, "state.json")):
            return True
    return False


def store_stamp(accounts=None):
    """Newest mtime across the account `jobs` DIRECTORIES.

    A new session is a new subdirectory, which bumps its parent's mtime. Watching
    only the records of known sessions - which is what this used to do - can never
    see one arrive.
    """
    newest = 0.0
    for _name, root in (accounts if accounts is not None else account_dirs()):
        try:
            newest = max(newest, os.path.getmtime(os.path.join(root, "jobs")))
        except OSError:
            pass
    return newest


def default_cwd(jobs):
    """Where a new session should start: the folder this view was opened in.

    An earlier version offered the folder MOST sessions already run in, which is
    a fact about history rather than about intent - open the view in one repo and
    it proposed a different one, because that is where the backlog happens to
    live. The terminal's own directory is the thing you actually chose, so that
    wins; the busy folder is only a fallback for the case where there is no
    usable one, and `tab` still completes to any folder in the list.
    """
    try:
        here = os.getcwd()
        if os.path.isdir(here):
            return here
    except OSError:
        pass
    counts = {}
    for job in jobs:
        if job["cwd"]:
            counts[job["cwd"]] = counts.get(job["cwd"], 0) + 1
    if counts:
        return max(sorted(counts), key=lambda c: counts[c])
    return os.path.expanduser("~")


def known_tags(jobs):
    return sorted({j["tag"] for j in jobs if j["tag"]})


def complete_tag(prefix, tags):
    """First tag that starts with what has been typed, for tab completion."""
    for t in tags:
        if t.startswith(prefix) and t != prefix:
            return t
    return None


# ---------------------------------------------------------- grouping / sort

def sort_key(job, pins):
    return (
        0 if job["short"] in pins else 1,
        STATE_RANK.get(job["state"], 9),
        # newest first within a state; the timestamps are ISO so they sort as text
        [-ord(c) for c in job["updated"]],
    )


def header_of(job, mode):
    if mode == "folder":
        cwd = job["cwd"] or "(no folder)"
        home = os.path.expanduser("~")
        return "~" + cwd[len(home):] if cwd.startswith(home) else cwd
    if mode == "state":
        return STATE_LABEL.get(job["state"], job["state"] or "Unknown")
    return job["tag"] or UNTAGGED


def matches(job, query):
    if not query:
        return True
    q = query.lower()
    return any(q in str(job[f]).lower() for f in ("name", "detail", "tag", "cwd", "short"))


def group_jobs(jobs, mode="tag", pins=(), query="", folded=()):
    """Ordered [(header, count, [job, ...]), ...]; a folded header keeps its count.

    Untagged sessions sink to the bottom in tag mode. That matters: it is what
    makes folding every tag but one behave as a tag picker, the way the built-in
    view does it.
    """
    pins = set(pins)
    folded = set(folded)
    buckets = {}
    for job in jobs:
        if not matches(job, query):
            continue
        buckets.setdefault(header_of(job, mode), []).append(job)

    def header_rank(item):
        head, rows = item
        if mode == "tag":
            sinks = 1 if head == UNTAGGED else 0
        elif mode == "state":
            sinks = min(STATE_RANK.get(r["state"], 9) for r in rows)
        else:
            sinks = 0
        pinned = 0 if any(r["short"] in pins for r in rows) else 1
        return (sinks, pinned, head.lower())

    out = []
    for head, rows in sorted(buckets.items(), key=header_rank):
        rows.sort(key=lambda j: sort_key(j, pins))
        out.append((head, len(rows), [] if head in folded else rows))
    return out


def flatten(groups):
    """Rows for the cursor to walk: ('head', name) and ('job', job)."""
    rows = []
    for head, count, jobs in groups:
        rows.append(("head", (head, count)))
        for job in jobs:
            rows.append(("job", job))
    return rows


# ---------------------------------------------------------------- actions

def claude_bin():
    """The binary to drive. `PP_AGENTS_CLAUDE` lets the tests stub it out.

    Only ever invoked with published subcommands - attach, logs, stop, --bg - so
    a new Claude Code release cannot change what this means underneath us.
    """
    override = os.environ.get("PP_AGENTS_CLAUDE")
    if override:
        return os.path.expanduser(override)
    return shutil.which("claude") or os.path.expanduser("~/.local/bin/claude")


def job_env(job):
    """Environment for a command about this session - the right account.

    CLAUDE_CONFIG_DIR is what separates the work and personal stores, so a
    command aimed at a personal session must not inherit the work value from
    whatever shell launched this tool.
    """
    env = dict(os.environ)
    env["CLAUDE_CONFIG_DIR"] = job["config_dir"]
    return env


def dispatch_env(account_dir):
    """Environment for CREATING a session, pinned to a store this view reads.

    Without this the new session goes wherever the launching shell points, and a
    shell that never selected an account points at Claude Code's default
    `~/.claude` - which this view does not read. The session is then created,
    reported, and invisible. `--doctor` names any store in that state.
    """
    env = dict(os.environ)
    env["CLAUDE_CONFIG_DIR"] = account_dir
    return env


def foreign_stores(candidates=None):
    """Stores holding session records that this view does NOT read.

    `~/.claude` is Claude Code's default and is not one of the accounts here, so
    anything dispatched by a shell with no account selected lands there unseen.
    """
    known = {os.path.realpath(root) for _name, root in account_dirs()}
    out = []
    for root in (candidates if candidates is not None
                 else (os.path.expanduser("~/.claude"),)):
        if os.path.realpath(root) in known:
            continue
        jobs = os.path.join(root, "jobs")
        try:
            found = [s for s in os.listdir(jobs)
                     if os.path.isfile(os.path.join(jobs, s, "state.json"))]
        except OSError:
            continue
        if found:
            out.append((root, len(found)))
    return out


def attach_cmd(job):
    return [claude_bin(), "attach", job["short"]]


def logs_cmd(job):
    return [claude_bin(), "logs", job["short"]]


def stop_cmd(job):
    return [claude_bin(), "stop", job["short"]]


def rm_cmd(job):
    return [claude_bin(), "rm", job["short"]]


def dispatch_cmd(prompt):
    return [claude_bin(), "--bg", prompt]


# Coming back out of a session.
#
# One key, swallowed here and never forwarded, so leaving is instant and depends
# on nothing Claude Code prints. An earlier version forwarded the plain left
# arrow and watched for Claude Code's own agents view to appear before detaching.
# That worked, but it could not be quick by construction: Claude Code's list had
# to finish drawing first, so every exit flashed the wrong screen. Reserving a
# key removes the wait and the flash together, and leaves the left arrow free to
# do its ordinary job of moving the cursor while you edit a prompt.
#
# `shift+left` is the choice because it sits under the same finger as the arrow
# it replaces, and a real session ignores it completely. `ctrl+o` was the old
# second fallback and is deliberately gone: Claude Code binds it to "see full
# summary", so swallowing it took a working shortcut away.
RESERVED_KEYS = {
    "\x1b[1;2D": "shift+left",
}
BACK_KEY = os.environ.get("PP_AGENTS_BACK_KEY", "")     # optional extra key
BACK_KEY_LABEL = os.environ.get("PP_AGENTS_BACK_KEY_LABEL", "shift+left")

# Terminal modes a borrowed program can leave switched on.
#
# `claude attach` turns on mouse reporting (1000/1002/1003/1006) and normally
# turns it off on the way out. Detaching does not let it exit normally, so the
# terminal keeps sending mouse packets - and the next thing to read stdin, your
# shell, prints them as text: `65;59;21M65;59;21M...` every time you move the
# mouse. Clearing these is not optional politeness; skipping it corrupts the
# shell you return to.
MOUSE_OFF = "".join(f"\x1b[?{m}l" for m in (1000, 1001, 1002, 1003, 1005, 1006, 1015))
BORROWED_MODES_OFF = (
    MOUSE_OFF
    + "\x1b[?1004l"     # focus in/out reporting
    + "\x1b[?2004l"     # bracketed paste
)
CURSOR_AND_COLOUR = "\x1b[?25h\x1b[0m"


def clear_borrowed_modes(extra="", drain=True):
    """Switch off input modes another program turned on. Safe to call anywhere.

    Switching mouse reporting off stops the terminal producing NEW packets. It
    does nothing about the ones already queued on stdin, and those are read by
    whatever runs next - your shell - which prints them as `35;3;19M` gibberish.
    So after the modes go off, wait a beat for anything in flight to land, then
    throw the queue away. `drain=False` is for callers that must not lose a
    keystroke.
    """
    try:
        sys.stdout.write(BORROWED_MODES_OFF + extra)
        sys.stdout.flush()
    except (OSError, ValueError):
        pass
    if not drain:
        return
    try:
        fd = sys.stdin.fileno()
        if os.isatty(fd):
            time.sleep(0.06)                  # let in-flight packets arrive
            termios.tcflush(fd, termios.TCIFLUSH)
    except (OSError, ValueError, termios.error):
        pass


def end_child(pid, grace=0.9):
    """Ask a child to exit, and give it time to tidy the terminal first.

    A signalled program still gets to run its exit handlers; `SIGKILL` does not.
    Claude Code resets the modes it set when it can, so try the polite signals
    with a real grace period and keep `SIGKILL` as the last resort.
    """
    for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGKILL):
        try:
            os.kill(pid, sig)
        except OSError:
            return
        waited = 0.0
        while waited < grace:
            try:
                if os.waitpid(pid, os.WNOHANG)[0]:
                    return
            except OSError:
                return
            time.sleep(0.05)
            waited += 0.05


DEBUG_LOG = os.environ.get("PP_AGENTS_DEBUG", "")


def dbg(msg):
    """Append a line to PP_AGENTS_DEBUG, if set. Silent otherwise.

    The proxy makes its decisions with the screen handed to another program, so
    there is nowhere to print. Without this the only way to find out why a detach
    did or did not happen is to guess.
    """
    if not DEBUG_LOG:
        return
    try:
        with open(DEBUG_LOG, "a") as fh:
            fh.write(f"{time.time():.3f} {msg}\n")
    except OSError:
        pass


def first_reserved(data, extra=""):
    """(offset, label) of the first reserved key in `data`, or (-1, None).

    Reserved keys are swallowed here and never reach Claude Code, so they must be
    keys nobody needs while typing.
    """
    best, label = -1, None
    keys = dict(RESERVED_KEYS)
    if extra:
        keys[extra] = "the configured key"
    for seq, name in keys.items():
        at = data.find(seq.encode())
        if at != -1 and (best == -1 or at < best):
            best, label = at, name
    return best, label


def run_proxied(cmd, env, cwd=None, back=BACK_KEY):
    """Run `cmd` on a pty we own, and come straight back here on `back`.

    Why this is not a plain `subprocess.call`: `claude attach` binds the left
    arrow to "back to the agents view" and opens **Claude Code's** ungrouped one,
    which strands you outside this view - and `esc` there does not exit, so there
    is no way home. Claude Code decides that internally and exposes no flag.
    `claude --resume` is not an alternative either; it refuses a background agent
    outright and tells you to use `claude agents`.

    So the bytes go through here. Everything is forwarded verbatim in both
    directions - alt-screen, mouse, bracketed paste, resizes - except one
    reserved key, which never reaches Claude Code and instead detaches and
    returns. The plain left arrow is forwarded like any other key, so it still
    moves the cursor; and if you do land in Claude Code's own list, the reserved
    key still brings you back from there.

    Detaching kills only the attach *client*. The session itself lives in the
    daemon and keeps running, exactly as it would if the terminal were closed.

    Returns the child's exit status, or None if it was detached.
    """
    if not sys.stdin.isatty():
        return subprocess.call(cmd, env=env, cwd=cwd or None)

    stdin_fd = sys.stdin.fileno()
    out_fd = sys.stdout.fileno()
    saved = termios.tcgetattr(stdin_fd)
    pid, master = pty.fork()
    if pid == 0:
        try:
            if cwd:
                os.chdir(cwd)
        except OSError:
            pass
        os.execvpe(cmd[0], cmd, env)
        os._exit(127)                                    # unreachable on success

    def sync_size(*_):
        try:
            size = fcntl.ioctl(out_fd, termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(master, termios.TIOCSWINSZ, size)
            os.kill(pid, signal.SIGWINCH)
        except (OSError, ValueError):
            pass

    prev_winch = signal.getsignal(signal.SIGWINCH)
    detached = False
    try:
        tty.setraw(stdin_fd)
        signal.signal(signal.SIGWINCH, sync_size)
        sync_size()
        while True:
            try:
                readable, _, _ = select.select([stdin_fd, master], [], [])
            except (OSError, select.error) as exc:
                if getattr(exc, "errno", None) == errno.EINTR:
                    continue                             # a resize woke select
                break
            if master in readable:
                try:
                    data = os.read(master, 1 << 16)
                except OSError:
                    break
                if not data:
                    break
                os.write(out_fd, data)
            if stdin_fd in readable:
                try:
                    data = os.read(stdin_fd, 1 << 16)
                except OSError:
                    break
                if not data:
                    break
                hit, key = first_reserved(data, back)
                if hit != -1:
                    dbg(f"reserved key {key!r} -> detaching")
                    if hit:
                        os.write(master, data[:hit])     # send what came before
                    detached = True
                    break
                os.write(master, data)
    finally:
        signal.signal(signal.SIGWINCH, prev_winch)
        termios.tcsetattr(stdin_fd, termios.TCSADRAIN, saved)
        if detached:
            end_child(pid)
        # Whether it exited on its own or was detached, switch off the input modes
        # it may have left on. Mouse reporting is the one that bites: left on, the
        # terminal keeps emitting mouse packets and whatever reads stdin next
        # prints them as `65;59;21M` gibberish.
        clear_borrowed_modes()
        try:
            os.close(master)
        except OSError:
            pass
    if detached:
        return None
    try:
        return os.waitpid(pid, 0)[1] >> 8
    except OSError:
        return 0


def run_attached(cmd, env, cwd=None):
    """Hand the whole terminal to a real command, then take it back.

    Curses owns the screen, so it must be suspended before `claude attach` draws
    its own full-screen UI. `def_prog_mode` / `reset_prog_mode` is the pattern
    that survives the round trip - calling `initscr()` a second time instead
    leaves the program wedged and takes the view down with it.
    """
    # A session's folder often no longer exists - worktrees get reaped, branches
    # get cleaned up. Launching in a missing directory raises, and an unhandled
    # raise here takes the whole view down, so fall back to wherever we are.
    if cwd and not os.path.isdir(cwd):
        cwd = None
    curses.def_prog_mode()
    curses.endwin()
    try:
        return run_proxied(cmd, env, cwd)
    except OSError as exc:
        print(f"pp-agents: could not run {cmd[0]}: {exc}")
        return 127
    finally:
        curses.reset_prog_mode()


# ---------------------------------------------------------------- rendering

def fmt_age(iso):
    """'4m', '3h', '2d' - the built-in view's shape, from an ISO timestamp."""
    if not iso:
        return ""
    try:
        t = time.mktime(time.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return ""
    # state.json stamps UTC; compare in the same frame
    secs = max(0, time.time() - (t - time.timezone))
    for cutoff, div, unit in ((60, 1, "s"), (3600, 60, "m"), (86400, 3600, "h")):
        if secs < cutoff:
            return f"{int(secs // div)}{unit}"
    return f"{int(secs // 86400)}d"


# The built-in view carries a permanent input line at the bottom - "describe a
# task for a new session" - and that line is the whole reason anyone knows the
# feature exists. `n` did the same job here from the start and nobody could find
# it, so the line is reproduced. It is a prompt-shaped label, not a live input:
# in this view the letters are shortcuts, so typing into it would collide with
# `j`, `k`, `e`, `d` and the rest.
NEW_HINT = "\u203a n   describe a task for a new session"

# How long to watch the store for a dispatched session before saying so.
# Generous, because it never blocks anything: the view redraws every pass.
DISPATCH_WAIT = float(os.environ.get("PP_AGENTS_DISPATCH_WAIT", "15"))

PIN_MARK = "▸"
FOLD_OPEN = "▾"      # open group
FOLD_SHUT = "▸"      # folded group          # a small right-pointing triangle

# One glyph per state, so the list can be skimmed by shape as well as by colour.
GLYPH = {
    "blocked": "●",     # filled circle - wants you
    "working": "◐",     # half-filled - busy
    "error": "▲",       # triangle - trouble
    "idle": "○",        # hollow circle
}


def state_glyph(state):
    return GLYPH.get(state, "·")   # middle dot for done and anything else


STATE_W = 12   # widest label, "Needs input", plus a space
AGE_W = 5
# the fixed cells around the elastic columns: two lead spaces, pin, glyph, and
# the single spaces after the glyph and after the name
ROW_CHROME = 6


def row_segments(job, width, pins):
    """One session line as [(text, kind), ...] - the single layout definition.

    The screen colours each segment by `kind`; `--dump` joins them into plain
    text. Both go through here so a rendering test means something: if the two
    drifted apart, the plain-text assertions would stop describing the screen.

    Layout is marker, name, state, last message, age. The name column is elastic
    and the right-hand columns are fixed so the ages line up.
    """
    pinned = job["short"] in pins
    label = STATE_LABEL.get(job["state"], job["state"] or "?")
    age = fmt_age(job["updated"])
    # In a narrow terminal the last message is the first thing to go: a readable
    # session name matters more than a truncated fragment of its last line.
    if width < 90:
        name_w = max(8, width - STATE_W - AGE_W - ROW_CHROME)
        detail_w = 0
    else:
        name_w = max(12, min(44, width - 42))
        detail_w = max(0, width - name_w - STATE_W - AGE_W - ROW_CHROME)
    name = f"{job['name']}"[:name_w].ljust(name_w)
    segs = [
        ("  ", "plain"),
        (PIN_MARK if pinned else " ", "pin"),
        (state_glyph(job["state"]), job["state"] or "done"),
        (" ", "plain"),
        (name, "name"),
        (" ", "plain"),
        (f"{label:<{STATE_W}}", job["state"] or "done"),
    ]
    if detail_w:
        segs.append((job["detail"][:detail_w].ljust(detail_w), "detail"))
    segs.append((f"{age:>{AGE_W}}", "age"))
    # never let the composed line exceed the width - an overflowing row corrupts
    # a curses screen rather than merely looking wrong
    out, used = [], 0
    for text, kind in segs:
        if used >= width:
            break
        text = text[:width - used]
        used += len(text)
        out.append((text, kind))
    return out


def row_text(job, width, pins):
    return "".join(t for t, _ in row_segments(job, width, pins))


