HELP = [
    ("up/down, j/k", "move"),
    ("enter", "open the session"),
    ("shift+left", "inside a session: come back here"),
    ("ctrl+e / e", "tag this session (tab completes an existing tag)"),
    ("ctrl+x / x", "remove this session's tag"),
    ("d", "delete this session (asks first; stops it if still running)"),
    ("ctrl+t / t", "pin to top"),
    ("ctrl+s / s", "cycle grouping: tag -> folder -> state"),
    ("space", "fold / unfold the group under the cursor"),
    ("/", "filter; esc clears"),
    ("l", "show recent output (claude logs)"),
    ("K", "stop this session (asks first)"),
    ("n", "start a new session: the task, then the folder (claude --bg)"),
    ("g", "refresh now"),
    ("?", "this help"),
    ("q", "quit"),
]


# The palette, in one place.
#
# Only the STATE colours are saturated, because they are the only thing worth
# your eye jumping to: what needs you, what is running, what is finished. Every
# other element - headers, counts, last message, age, the bars - is a muted grey
# or a soft steel blue. The first version coloured the chrome as loudly as the
# states, which made the whole list shout and nothing stand out.
#
# 256-colour numbers, with an 8-colour fallback below.
GREY_TEXT = 245         # the last message
GREY_FAINT = 243        # counts, age
GREY_BAR_FG = 252       # bar text
GREY_BAR_BG = 236       # bar background: chrome, not a neon strip
SEL_BG = 237            # the cursor row: a shade lifted, not inverted
STEEL = 110             # group headers: present without shouting
AMBER_SOFT = 179        # the pin marker


def init_colours():
    """Two attribute maps: (normal, cursor-row). Keyed by segment kind.

    `use_default_colors` is load-bearing: without it curses paints every cell
    with its own idea of "black", which on a themed terminal shows up as
    rectangular blocks behind the text instead of a background.

    The cursor row gets its own map rather than `A_REVERSE` over the normal one.
    Reverse video inverts the saturated state colours into full-width blocks of
    yellow or green, which is exactly the "popping" this palette avoids; a second
    set of pairs sharing one background keeps the row legible and the state
    colours intact.
    """
    mono = {
        "header": curses.A_BOLD, "count": curses.A_DIM, "name": curses.A_NORMAL,
        "detail": curses.A_DIM, "age": curses.A_DIM, "pin": curses.A_BOLD,
        "blocked": curses.A_BOLD, "working": curses.A_BOLD, "error": curses.A_BOLD,
        "idle": curses.A_DIM, "done": curses.A_NORMAL, "plain": curses.A_NORMAL,
        "bar": curses.A_REVERSE, "hint": curses.A_DIM,
    }
    mono_sel = {k: v | curses.A_REVERSE for k, v in mono.items()}
    try:
        curses.start_color()
        curses.use_default_colors()
    except curses.error:
        return mono, mono_sel
    if not curses.has_colors():
        return mono, mono_sel

    rich = curses.COLORS >= 256
    counter = [1]

    def pair(fg, bg=-1, attr=0):
        idx = counter[0]
        counter[0] += 1
        try:
            curses.init_pair(idx, fg, bg)
            return curses.color_pair(idx) | attr
        except curses.error:
            return attr

    def states(bg):
        # unchanged, and the only saturated colours in the list
        return {
            "blocked": pair(curses.COLOR_YELLOW, bg, curses.A_BOLD),
            "working": pair(curses.COLOR_CYAN, bg),
            "done": pair(curses.COLOR_GREEN, bg),
            "error": pair(curses.COLOR_RED, bg, curses.A_BOLD),
        }

    def chrome(bg):
        grey = GREY_TEXT if rich else curses.COLOR_WHITE
        faint = GREY_FAINT if rich else curses.COLOR_WHITE
        steel = STEEL if rich else curses.COLOR_BLUE
        amber = AMBER_SOFT if rich else curses.COLOR_YELLOW
        dim = 0 if rich else curses.A_DIM
        plain = pair(-1, bg) if bg != -1 else curses.A_NORMAL
        out = {
            "header": pair(steel, bg, curses.A_BOLD),
            "count": pair(faint, bg, dim),
            "name": plain,
            "detail": pair(grey, bg, dim),
            "age": pair(faint, bg, dim),
            "pin": pair(amber, bg),
            "idle": pair(faint, bg, dim),
            "plain": plain,
            "hint": pair(grey, bg, dim),
        }
        out.update(states(bg))
        return out

    normal = chrome(-1)
    # the bars are chrome: light text on a dark grey band, no reverse video
    normal["bar"] = (pair(GREY_BAR_FG, GREY_BAR_BG) if rich
                     else curses.A_REVERSE | curses.A_BOLD)
    selected = chrome(SEL_BG if rich else -1)
    if not rich:
        selected = {k: v | curses.A_REVERSE for k, v in selected.items()}
    selected["bar"] = normal["bar"]
    return normal, selected


class App:
    def __init__(self, scr):
        self.scr = scr
        self.attr, self.attr_sel = init_colours()
        self.mode = "tag"
        self.folded = set()
        self.query = ""
        self.pins = load_pins()
        self.cursor = 0
        self.placed = False
        self.status = ""
        self.show_help = False
        self.reload()

    def reload(self):
        self.jobs = load_jobs()
        self.rebuild()

    def rebuild(self, keep_cursor=True):
        """Recompute the visible rows, keeping the cursor sensible.

        On the first build the cursor lands on the first *session*, not on the
        header above it: every action except folding needs a session, and having
        to press down once before anything works is the kind of friction that
        stops a replacement being used.
        """
        self.groups = group_jobs(self.jobs, self.mode, self.pins, self.query, self.folded)
        self.rows = flatten(self.groups)
        if not self.rows:
            self.cursor = 0
            return
        if not self.placed or not keep_cursor:
            self.cursor = next((i for i, (k, _) in enumerate(self.rows) if k == "job"), 0)
            self.placed = True
        self.cursor = max(0, min(self.cursor, len(self.rows) - 1))

    def focused(self):
        if not self.rows:
            return None, None
        kind, payload = self.rows[self.cursor]
        return kind, payload

    def focused_job(self):
        kind, payload = self.focused()
        return payload if kind == "job" else None

    # -------------------------------------------------------- drawing

    def put(self, y, x, text, attr=0):
        """Write clipped text and return the next column.

        curses raises if anything reaches the bottom-right cell, so every write
        goes through here rather than trusting the caller's arithmetic.
        """
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w - 1:
            return x
        text = text[:max(0, w - 1 - x)]
        if text:
            try:
                self.scr.addstr(y, x, text, attr)
            except curses.error:
                pass
        return x + len(text)

    def draw(self):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        counts = {}
        for j in self.jobs:
            counts[j["state"]] = counts.get(j["state"], 0) + 1
        bits = [f"{counts.get('blocked', 0)} need input"]
        if counts.get("working"):
            bits.append(f"{counts['working']} working")
        bits.append(f"{counts.get('done', 0)} done")
        title = f" pp-agents · by {self.mode} · " + " · ".join(bits)
        self.put(0, 0, title.ljust(w - 1), self.attr["bar"])

        if self.show_help:
            self.draw_help(h, w)
        else:
            self.draw_rows(h, w)

        if h >= 4 and not self.show_help:
            self.put(h - 2, 0, NEW_HINT.ljust(w - 1), self.attr["hint"])

        if self.status:
            bar, attr = " " + self.status, self.attr["bar"]
        elif self.query:
            bar, attr = f" filter: {self.query}   (esc clears)", self.attr["bar"]
        else:
            bar, attr = (" enter open · shift+left back · e tag · d delete · "
                         "t pin · s group · / filter · ? help · q quit"), self.attr["bar"]
        self.put(h - 1, 0, bar.ljust(w - 1), attr)
        self.scr.refresh()

    def draw_help(self, h, w):
        self.put(2, 2, "keys", self.attr["header"])
        for i, (k, d) in enumerate(HELP):
            if 4 + i >= h - 2:
                break
            x = self.put(4 + i, 4, f"{k:<16}", self.attr["blocked"])
            self.put(4 + i, x, d, self.attr["name"])
        line = 5 + len(HELP)
        for j, note in enumerate((
                "tags live in Claude Code's own group file, so nothing is lost",
                "if the built-in tag view ever starts working again.")):
            if line + j < h - 2:
                self.put(line + j, 2, note, self.attr["detail"])

    def draw_rows(self, h, w):
        """Draw headers and sessions, colouring each piece by what it means.

        Only the cursor row gets a background. Everything else is foreground
        colour on the terminal's own background, which is what stops the list
        looking like a grid of black rectangles.
        """
        # h-1 is the status bar and h-2 is the new-session line, so the list
        # stops two rows early. On a terminal too short for the hint it is not
        # drawn, and the row is the list's again.
        last = h - 2 if h >= 4 else h - 1
        body = max(1, last - 1)
        first = 0
        if self.cursor >= body:
            first = self.cursor - body + 1
        y = 1
        for idx in range(first, len(self.rows)):
            if y >= last:
                break
            kind, payload = self.rows[idx]
            sel = idx == self.cursor
            attr = self.attr_sel if sel else self.attr
            if sel:
                # lay the row's background down first so it spans the full width
                self.put(y, 0, " " * (w - 1), attr["plain"])
            if kind == "head":
                head, count = payload
                arrow = FOLD_SHUT if head in self.folded else FOLD_OPEN
                x = self.put(y, 0, f" {arrow} ", attr["header"])
                x = self.put(y, x, head, attr["header"])
                self.put(y, x, f"  {count}", attr["count"])
            else:
                x = 0
                for text, seg in row_segments(payload, w - 2, self.pins):
                    x = self.put(y, x, text, attr.get(seg, attr["plain"]))
            y += 1
        if not self.rows:
            msg = ("nothing matched that filter" if self.query
                   else "no sessions found - run  pp-agents --doctor")
            self.put(2, 2, msg, self.attr["hint"])

    # -------------------------------------------------------- input

    def prompt(self, label, complete_from=(), preset=""):
        """One-line input on the status bar. Returns None if cancelled.

        `preset` starts the line filled in and editable, which is what makes a
        sensible default worth offering: accept it with enter, or backspace it
        away.
        """
        h, w = self.scr.getmaxyx()
        buf = preset
        curses.curs_set(1)
        self.scr.timeout(-1)        # same sticky-timeout trap as confirm()
        try:
            while True:
                shown = f"{label}{buf}"
                hint = ""
                if complete_from:
                    c = complete_tag(buf, complete_from)
                    if c:
                        hint = f"   (tab -> {c})"
                self.put(h - 1, 0, (shown + hint).ljust(w - 1), self.attr["bar"])
                self.scr.refresh()
                ch = self.scr.getch()
                if ch in (10, 13):
                    return buf
                if ch == 27:
                    return None
                if ch in (curses.KEY_BACKSPACE, 127, 8):
                    buf = buf[:-1]
                elif ch == 9 and complete_from:
                    c = complete_tag(buf, complete_from)
                    if c:
                        buf = c
                elif 32 <= ch < 127:
                    buf += chr(ch)
        finally:
            curses.curs_set(0)
            self.scr.timeout(1000)

    def confirm(self, question):
        """Ask a yes/no question on the status bar and WAIT for the answer.

        `timeout(-1)` is the point. The main loop runs `timeout(1000)` so it can
        wake up and refresh; that setting is sticky, so without this a question
        answers itself "no" after one second of hesitation and reports "not
        stopped" as though you had declined it.
        """
        h, w = self.scr.getmaxyx()
        self.put(h - 1, 0, (question + "  [y/N]").ljust(w - 1), self.attr["bar"])
        self.scr.refresh()
        self.scr.timeout(-1)
        try:
            return self.scr.getch() in (ord("y"), ord("Y"))
        finally:
            self.scr.timeout(1000)

    def move(self, delta):
        if not self.rows:
            return
        self.cursor = max(0, min(len(self.rows) - 1, self.cursor + delta))

    def act_open(self):
        job = self.focused_job()
        if not job:
            self.toggle_fold()
            return
        code = run_attached(attach_cmd(job), job_env(job), job["cwd"])
        self.restore_screen()
        self.reload()
        self.status = (f"back from {job['name']}" if code == 0
                       else f"{job['name']} exited {code}")

    def act_logs(self):
        job = self.focused_job()
        if not job:
            return
        curses.def_prog_mode()
        curses.endwin()
        try:
            subprocess.call(logs_cmd(job), env=job_env(job))
            try:
                input("\n-- enter to return to pp-agents --")
            except (EOFError, KeyboardInterrupt):
                pass
        finally:
            clear_borrowed_modes()
            curses.reset_prog_mode()
        self.restore_screen()

    def act_stop(self):
        job = self.focused_job()
        if not job:
            return
        if not self.confirm(f"stop {job['name']}?"):
            self.status = "not stopped"
            return
        blob = run_claude(stop_cmd(job), env=job_env(job))
        self.status = blob.splitlines()[-1] if blob else "stop issued"
        self.reload()

    def act_delete(self):
        """Delete the focused session, stopping it first if it is still running.

        Deleting a live session would leave the daemon writing into a directory
        that no longer exists, so it is stopped and given a moment to notice
        before the record goes. The question says which of the two is happening.
        """
        job = self.focused_job()
        if not job:
            return
        live = job["state"] in LIVE_STATES
        question = (f"stop AND delete {job['name']}?" if live
                    else f"delete {job['name']}?")
        if not self.confirm(question):
            self.status = "not deleted"
            return
        if live:
            run_claude(stop_cmd(job), env=job_env(job))
            time.sleep(0.4)
        # `claude rm` is the published delete and the only one the daemon honours
        blob = run_claude(rm_cmd(job), env=job_env(job))
        deadline = time.time() + 4.0
        while time.time() < deadline and record_exists(job["short"]):
            time.sleep(0.1)
        if record_exists(job["short"]):
            # rm reported success but left the directory: tidy it ourselves
            try:
                delete_record(job)
            except (OSError, ValueError) as exc:
                self.status = f"not deleted: {blob or exc}"
                return
        self.pins.discard(job["short"])
        save_pins(self.pins)
        self.reload()
        self.status = f"deleted {job['name']}"

    def act_tag(self):
        job = self.focused_job()
        if not job:
            return
        tags = known_tags(self.jobs)
        cur = job["tag"] or ""
        new = self.prompt(f"tag [{cur}]: ", tags)
        if new is None:
            self.status = "unchanged"
            return
        write_tag(job, new if new.strip() else cur if new == "" else new)
        self.rebuild()
        self.status = f"tag = {job['tag'] or '(none)'}"

    def act_untag(self):
        job = self.focused_job()
        if not job:
            return
        write_tag(job, "")
        self.rebuild()
        self.status = "tag removed"

    def act_pin(self):
        job = self.focused_job()
        if not job:
            return
        self.pins.symmetric_difference_update({job["short"]})
        save_pins(self.pins)
        self.rebuild()
        self.status = "pinned" if job["short"] in self.pins else "unpinned"

    def act_new(self):
        """Dispatch a background session, asking for the task first.

        The task is what you already have in your head when you reach for this;
        the folder is a detail, so it comes second and arrives pre-filled with
        the one most of your sessions run in.
        """
        task = self.prompt("new session - describe the task: ")
        if not task or not task.strip():
            self.status = "nothing dispatched"
            return
        cwds = sorted({j["cwd"] for j in self.jobs if j["cwd"]})
        where = self.prompt("folder: ", cwds, preset=default_cwd(self.jobs))
        if not where:
            self.status = "nothing dispatched"
            return
        where = os.path.expanduser(where.strip())
        prompt = task
        if not os.path.isdir(where):
            self.status = f"no such folder: {where}"
            return
        before = {j["short"] for j in self.jobs}
        account, account_dir = account_dirs()[0]
        proc, log = start_claude(dispatch_cmd(prompt), cwd=where,
                                 env=dispatch_env(account_dir))
        self.status = "starting a session ..."
        self.draw()

        # Watch for the session to APPEAR rather than for the command to finish.
        # The record is what the owner is waiting to see, the command is not, and
        # nothing here can block: every pass redraws, so the view stays alive.
        short = None
        deadline = time.time() + DISPATCH_WAIT
        while time.time() < deadline:
            self.reload()
            fresh = sorted({j["short"] for j in self.jobs} - before)
            if fresh:
                short = fresh[0]
                break
            self.draw()
            time.sleep(0.25)

        if short:
            self.select_short(short)
            self.status = f"started {short}"
            try:
                os.unlink(log)
            except OSError:
                pass
            return
        if proc is None or proc.poll() not in (None, 0):
            self.status = last_line(log) or f"dispatch failed - see {log}"
        else:
            self.status = (f"no session appeared in {DISPATCH_WAIT:.0f}s "
                           f"under {account} - see {log}")

    def select_short(self, short):
        """Move the cursor onto a session by short id. False if it is not listed."""
        for idx, (kind, payload) in enumerate(self.rows):
            if kind == "job" and payload["short"] == short:
                self.cursor = idx
                return True
        return False

    def toggle_fold(self):
        kind, payload = self.focused()
        if kind == "head":
            head = payload[0]
            self.folded.symmetric_difference_update({head})
        elif kind == "job":
            head = header_of(payload, self.mode)
            self.folded.add(head)
        self.rebuild()

    def restore_screen(self):
        """Repaint after another program had the terminal.

        `redrawwin` is the part that matters: curses still believes the screen
        holds what it last drew, so without it the view comes back as fragments
        of itself over whatever `claude attach` left behind.
        """
        curses.curs_set(0)
        self.scr.keypad(True)
        self.scr.redrawwin()
        self.scr.refresh()

    def handle(self, ch):
        if self.show_help:
            self.show_help = False
            return True
        if ch in (ord("q"), 27) and not self.query:
            return False
        if ch == 27:
            self.query = ""
            self.rebuild()
            return True
        if ch in (curses.KEY_DOWN, ord("j")):
            self.move(1)
        elif ch in (curses.KEY_UP, ord("k")):
            self.move(-1)
        elif ch == curses.KEY_NPAGE:
            self.move(10)
        elif ch == curses.KEY_PPAGE:
            self.move(-10)
        elif ch in (10, 13):
            self.act_open()
        elif ch == ord(" "):
            self.toggle_fold()
        elif ch in (5, ord("e")):            # ctrl+e
            self.act_tag()
        elif ch in (24, ord("x")):           # ctrl+x
            self.act_untag()
        elif ch in (20, ord("t")):           # ctrl+t
            self.act_pin()
        elif ch in (19, ord("s")):           # ctrl+s
            self.mode = GROUP_MODES[(GROUP_MODES.index(self.mode) + 1) % len(GROUP_MODES)]
            self.folded.clear()
            self.rebuild()
            self.status = f"grouped by {self.mode}"
        elif ch == ord("/"):
            q = self.prompt("filter: ")
            self.query = q or ""
            self.rebuild()
        elif ch == ord("l"):
            self.act_logs()
        elif ch == ord("K"):
            self.act_stop()
        elif ch == ord("d"):
            self.act_delete()
        elif ch == ord("n"):
            self.act_new()
        elif ch == ord("g"):
            self.reload()
            self.status = "refreshed"
        elif ch == ord("?"):
            self.show_help = True
        return True

    def loop(self):
        last = 0.0
        while True:
            self.draw()
            self.scr.timeout(1000)
            ch = self.scr.getch()
            if ch == -1:
                # cheap auto-refresh: only re-read when something changed.
                # `store_stamp` is the half that notices a session ARRIVING - the
                # per-record loop below only ever sees the ones already listed.
                newest = store_stamp()
                for j in self.jobs:
                    try:
                        newest = max(newest, os.path.getmtime(os.path.join(j["dir"], "state.json")))
                    except OSError:
                        pass
                if newest > last:
                    last = newest
                    self.reload()
                continue
            self.status = ""
            if not self.handle(ch):
                return


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__)
        return 0
    if "--doctor" in argv:
        return cmd_doctor()
    if "--dump" in argv:
        return cmd_dump(argv)
    if "--list" in argv:
        return cmd_list(argv)

    def run(scr):
        curses.curs_set(0)
        App(scr).loop()

    try:
        curses.wrapper(run)
    except KeyboardInterrupt:
        pass
    finally:
        # A borrowed program's modes outlive it. Leave the shell as we found it.
        clear_borrowed_modes(CURSOR_AND_COLOUR)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
