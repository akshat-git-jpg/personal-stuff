def cmd_list(argv):
    jobs = load_jobs()
    pins = load_pins()
    mode = "tag"
    for i, a in enumerate(argv):
        if a == "--group" and i + 1 < len(argv):
            mode = argv[i + 1]
    for head, count, rows in group_jobs(jobs, mode, pins):
        print(f"{head} ({count})")
        for j in rows:
            print(f"  {j['short']}  {j['account']:<9}{STATE_LABEL.get(j['state'], j['state']):<12}"
                  f"{fmt_age(j['updated']):>4}  {j['name']}")
    return 0


def cmd_dump(argv):
    """Print exactly what the view would draw, as plain text.

    The TUI and this share `group_jobs`, `flatten` and `row_text`, so the layout
    can be asserted on character by character without a terminal. Curses only
    ever sends the cells that changed, which makes scraping a live screen an
    unreliable way to prove a key did the right thing - and unreliable tests are
    how the approach this replaces shipped broken.

        pp-agents --dump [--group tag|folder|state] [--filter Q]
                         [--fold HEADER] [--width N] [--pin SHORT]
    """
    def opt(flag, default=None):
        return argv[argv.index(flag) + 1] if flag in argv and argv.index(flag) + 1 < len(argv) else default

    mode = opt("--group", "tag")
    if mode not in GROUP_MODES:
        print(f"unknown grouping {mode!r}; expected one of {', '.join(GROUP_MODES)}", file=sys.stderr)
        return 2
    width = int(opt("--width", "170"))
    folded = {argv[i + 1] for i, a in enumerate(argv) if a == "--fold" and i + 1 < len(argv)}
    pins = {argv[i + 1] for i, a in enumerate(argv) if a == "--pin" and i + 1 < len(argv)}
    pins |= load_pins()

    jobs = load_jobs()
    counts = {}
    for j in jobs:
        counts[j["state"]] = counts.get(j["state"], 0) + 1
    print(f"pp-agents  grouped by {mode}   {counts.get('blocked', 0)} need input, "
          f"{counts.get('working', 0)} working, {counts.get('done', 0)} done")
    groups = group_jobs(jobs, mode, pins, opt("--filter", ""), folded)
    if not groups:
        print("(nothing matched)")
        return 0
    for head, count, rows in groups:
        mark = FOLD_SHUT if head in folded else FOLD_OPEN
        print(f" {mark} {head}  {count}")
        for j in rows:
            print(row_text(j, width, pins))
    return 0


def cmd_doctor():
    """Say plainly what can be read and what can be driven.

    The patch it replaces failed by reporting success, so this reports the two
    things that actually matter and never guesses.
    """
    ok = True
    accounts = account_dirs()
    print("accounts:")
    for name, path in accounts:
        n = len(os.listdir(os.path.join(path, "jobs")))
        print(f"  {name:<9}{path}  ({n} job records)")
    if not accounts:
        print("  none found - expected ~/.claude-work/jobs or ~/.claude-personal/jobs")
        ok = False

    stray = foreign_stores()
    if stray:
        print("\nsessions in a store this view does NOT read:")
        for path, count in stray:
            print(f"  {path}  ({count} records)")
        print("  a shell with no CLAUDE_CONFIG_DIR set dispatches into Claude")
        print("  Code's own default, and nothing here lists it. `claude rm <id>`")
        print("  clears one; new sessions from this view can no longer land there.")

    jobs = load_jobs(accounts)
    readable = [j for j in jobs if j["state"] or j["name"]]
    print(f"\nsession records parsed: {len(readable)} of {len(jobs)}")
    if jobs and not readable:
        print("  every record parsed empty - the on-disk format may have changed")
        ok = False
    print(f"tags found: {', '.join(known_tags(jobs)) or '(none yet)'}")

    binp = claude_bin()
    print(f"\nclaude binary: {binp}")
    if not os.path.exists(binp):
        print("  MISSING - attach/logs/stop cannot run")
        return 1
    for sub in ("attach", "logs", "stop", "rm"):
        out = subprocess.run([binp, sub, "--help"], capture_output=True, text=True, timeout=60)
        good = f"claude {sub} <id>" in (out.stdout + out.stderr)
        print(f"  {sub:<7}{'ok' if good else 'NOT AVAILABLE'}")
        ok = ok and good
    print("\n" + ("all good" if ok else "problems above"))
    return 0 if ok else 1


