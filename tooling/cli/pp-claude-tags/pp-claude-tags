#!/usr/bin/env python3
"""Unlock Claude Code's built-in session tags in the agents view.

Claude Code ships the tag feature (it calls them groups) but the agents view
hardcodes its gate to false, so `ctrl+e` (set tag) and the tag view are dead.
This flips that one byte, re-signs the binary, and verifies it still runs —
restoring the original byte if anything goes wrong.

The gate is found by the SHAPE of the surrounding code, not by minified
variable names, because those are regenerated every release (it was `X` in
2.1.237, `Q` in 2.1.238, `q` in 2.1.239). One match is required; anything else
is treated as "this build changed too much" and the binary is left alone.

Idempotent and cheap to re-run: a stamp file skips the scan when the binary has
not changed, so it can sit in a shell startup function.

Exit codes: 0 = patched, already patched, or safely skipped. 1 = failed and
rolled back.
"""
import fcntl
import hashlib
import json
import mmap
import os
import re
import subprocess
import sys

LAUNCHER = os.path.expanduser("~/.local/bin/claude")
STAMP = os.path.expanduser("~/.cache/pp-claude-tags.json")
LOCK = os.path.expanduser("~/.cache/pp-claude-tags.lock")
NOHEAL = os.path.expanduser("~/.cache/pp-claude-tags-noheal")
CONFIGS = [
    os.path.expanduser("~/.claude-work/.claude.json"),
    os.path.expanduser("~/.claude-personal/.claude.json"),
]

_ID = rb"[A-Za-z_$][\w$]*"

# Strategy 1 — code shape:
#   ...capExpanded:X}=hook(M), GATE=!1, [S]=useState(()=>make(host,GATE))
# The useState wrapper is `React.useState(...)` in some builds and a bare
# minified call in others (2.1.243), so the `React.` half is optional.
# The back-reference ties the flag to the store it is passed into, which is what
# makes this specific enough to patch blind.
BY_SHAPE = re.compile(
    rb"capExpanded:" + _ID + rb"\}=" + _ID + rb"\(" + _ID + rb"\),"
    rb"(" + _ID + rb")=!([01]),"
    rb"\[" + _ID + rb"\]=(?:" + _ID + rb"\.)?" + _ID + rb"\(\(\)=>" + _ID + rb"\(" + _ID + rb",\1\)\)"
)

# Strategy 2 — the property name Anthropic wrote, which minification leaves
# alone: the gate is handed around as `{groupsEnabled:<gate>}`. That names the
# gate variable exactly, wherever it is read.
#
# It used to be enough to anchor on the store call `attachView({groupsEnabled:X})`
# and look for X's declaration beside it. 2.1.243 split the bundle into chunks
# and moved that call into a chunk of its own, where X is only a function
# parameter — the declaration now lives in the caller. So every `groupsEnabled:`
# read is treated as a candidate anchor instead, and only the ones with a
# `<name>=!0/!1` declaration within NEAR bytes survive. Reads that are merely
# props or parameters have no declaration nearby and drop out. Short minified
# names repeat across a 344MB bundle, so the surviving declarations must all
# point at exactly one offset.
BY_PROP = re.compile(rb"groupsEnabled:(" + _ID + rb")[,}]")
NEAR = 12_000

QUIET = "-q" in sys.argv or "--quiet" in sys.argv


def say(msg):
    if not QUIET:
        print(f"pp-claude-tags: {msg}")


def warn(msg):
    print(f"pp-claude-tags: {msg}", file=sys.stderr)


def alert(msg):
    """Put a failure on screen.

    The launch agent runs unattended, so a warning in its log is a warning
    nobody reads — the first symptom is noticing your tags are gone, hours
    later. A desktop notification turns that into an immediate, obvious signal.
    """
    warn(msg)
    body = msg.replace('"', "'").replace("\\", "")
    try:
        subprocess.run(
            ["osascript", "-e",
             f'display notification "{body}" with title "Claude Code tags need a fix"'],
            capture_output=True, timeout=20,
        )
    except (subprocess.TimeoutExpired, OSError):
        pass


def fingerprint(path):
    st = os.stat(path)
    return hashlib.sha256(
        f"{os.path.realpath(path)}:{st.st_size}:{st.st_mtime_ns}".encode()
    ).hexdigest()


def read_stamp():
    try:
        with open(STAMP) as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}


def save_stamp(data):
    os.makedirs(os.path.dirname(STAMP), exist_ok=True)
    tmp = STAMP + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.replace(tmp, STAMP)


def write_stamp(path):
    stamp = read_stamp()
    stamp.update({"fingerprint": fingerprint(path), "patched": True})
    save_stamp(stamp)


def _by_shape(mm):
    hits = list(BY_SHAPE.finditer(mm))
    if len(hits) != 1:
        return None
    return hits[0].start(2), hits[0].group(2).decode()


def _by_prop(mm):
    """Every `groupsEnabled:<name>` read, kept only if <name> is declared nearby.

    The declaration is searched inside a window around the read rather than
    across the whole binary: a 344MB scan per candidate takes minutes, and a
    match that far away would be a different `F` anyway.
    """
    found = {}
    size = len(mm)
    for use in BY_PROP.finditer(mm):
        decl = re.compile(rb"[^\w$.]" + re.escape(use.group(1)) + rb"=!([01])[,;)]")
        lo = max(0, use.start() - NEAR)
        window = mm[lo:min(size, use.start() + NEAR)]
        for m in decl.finditer(window):
            found[lo + m.start(1)] = m.group(1).decode()
    if len(found) != 1:
        return None
    return next(iter(found.items()))


def find_gate(path):
    """Return (offset_of_digit, current_value) or (None, reason).

    Two independent strategies, so one refactor does not take the whole thing
    out. They must agree if both fire.
    """
    with open(path, "rb") as fh:
        with mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ) as mm:
            shape = _by_shape(mm)
            prop = _by_prop(mm)
            if shape and prop and shape[0] != prop[0]:
                return None, "the two gate strategies disagree"
            hit = shape or prop
            if hit is None:
                return None, "gate not found"
            return hit


def codesign(path):
    out = subprocess.run(
        ["codesign", "-f", "-s", "-", path], capture_output=True, text=True
    )
    if out.returncode != 0:
        warn(f"codesign failed: {out.stderr.strip()[:200]}")
        return False
    return True


def runs(path):
    try:
        out = subprocess.run(
            [path, "--version"], capture_output=True, text=True, timeout=120
        )
    except (subprocess.TimeoutExpired, OSError) as exc:
        warn(f"could not run patched binary: {exc}")
        return False
    return out.returncode == 0 and "Claude Code" in out.stdout


def write_byte(path, offset, value):
    with open(path, "r+b") as fh:
        fh.seek(offset)
        fh.write(value)


FIGHT_AFTER = 3


def restore_group_view():
    """Re-select the tag view. Returns True if anything had to be corrected.

    Every Claude Code session keeps `fleetViewGroupMode` in memory and writes it
    back on its next save. A session on a gate-off build clamps it to a mode the
    locked view still allows; a session on a patched build re-saves whatever the
    value happened to be when it started. Either way the tags look deleted while
    the tag files on disk are untouched.

    So this runs on every invocation. It used to run only while a process older
    than the patch was alive, on the reasoning that nothing else could clamp the
    setting and a deliberate `ctrl+s` should therefore be respected. That gate
    lost the race: the clamping write can land after the last recognisably-old
    process is gone, and then nothing looks at the setting again. That is how the
    agents view sat on folders for a whole day on 2026-08-26 with a correctly
    patched 2.1.246 and every tag still on disk.

    Correcting it unconditionally is what the owner wants; the cost is that
    `ctrl+s` to the folder or state view no longer sticks. To keep a different
    view: `touch ~/.cache/pp-claude-tags-noheal`.
    """
    if os.path.exists(NOHEAL):
        return False
    healed = False
    for path in CONFIGS:
        if not os.path.exists(path):
            continue
        try:
            with open(path) as fh:
                data = json.load(fh)
            if data.get("fleetViewGroupMode") == "group":
                continue
            data["fleetViewGroupMode"] = "group"
            tmp = path + ".tmp"
            with open(tmp, "w") as fh:
                json.dump(data, fh, indent=2)
            os.replace(tmp, path)
            healed = True
            say(f"re-selected the tag view in {os.path.basename(os.path.dirname(path))}")
        except (OSError, json.JSONDecodeError) as exc:
            warn(f"could not update {path}: {exc}")
    return healed


def heal_view():
    """Correct the view setting, and speak up if something keeps undoing it.

    A healthy run corrects it once, right after an update. Correcting it on
    several runs in a row means a live session is writing the old value back
    every time it saves, and the script cannot win that on its own — the session
    holding the stale value has to go. Only the owner can do that, so say so,
    once per fight rather than every run.
    """
    stamp = read_stamp()
    if not restore_group_view():
        if stamp.get("heals"):
            stamp["heals"] = 0
            save_stamp(stamp)
        return
    count = stamp.get("heals", 0) + 1
    stamp["heals"] = count
    save_stamp(stamp)
    if count == FIGHT_AFTER:
        alert(
            "a running session keeps putting the folder view back — quit the "
            "oldest Claude Code session, or press ctrl+s in it, so it stops "
            "overwriting the tag view"
        )


def main():
    if not os.path.exists(LAUNCHER):
        warn(f"no claude launcher at {LAUNCHER}")
        return 0
    target = os.path.realpath(LAUNCHER)

    if read_stamp().get("fingerprint") == fingerprint(target):
        say("already unlocked (stamp current)")
        # The binary is fine, but any live session can have written the view
        # setting back since. That is the half of this that is never done.
        heal_view()
        return 0

    offset, value = find_gate(target)
    if offset is None:
        # A release changed this code too much to patch blind. Leave it alone:
        # the agents view keeps working, just without tags.
        alert(
            f"{value} in {os.path.basename(target)} — left unpatched, "
            "tags are hidden until the pattern is updated."
        )
        return 0

    if value == "0":
        say("already unlocked")
        write_stamp(target)
        heal_view()
        return 0

    say(f"unlocking tags in {os.path.basename(target)}")
    write_byte(target, offset, b"0")
    if not codesign(target) or not runs(target):
        warn("patched binary did not run — rolling back")
        write_byte(target, offset, b"1")
        codesign(target)
        if runs(target):
            alert("patch did not run, rolled back — Claude Code is fine, tags hidden")
        else:
            alert(f"ROLLBACK FAILED — reinstall Claude Code or delete {target}")
        return 1

    write_stamp(target)
    heal_view()
    say("tags unlocked — ctrl+e tags, ctrl+s tag view, ctrl+r renames")
    return 0


def main_locked():
    """Serialise runs.

    The shell hook, the launchd watch and its interval can all fire at once. Two
    instances patching the same file race: one sees the other's half-written
    binary, calls it a failure and rolls the byte back. One at a time; the rest
    exit quietly, because whoever holds the lock is already doing the work.
    """
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            say("another run is in progress — skipping")
            return 0
        return main()
    finally:
        os.close(fd)


if __name__ == "__main__":
    sys.exit(main_locked())
