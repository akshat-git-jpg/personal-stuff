#!/usr/bin/env bash
# pp-work — per-session and per-subject git worktrees that are NEVER reset.
#
# Distinct from `wt` on purpose. `wt` is a fixed pool of 8 slots that RESETS a slot on
# acquire and on return; a session's in-progress work must survive exactly that. The two
# live under different roots so `wt return`'s own guard ($POOL/*/<repo>) can never match a
# workspace.
set -euo pipefail

die() { echo "pp-work: $*" >&2; exit 1; }

# Absolute path to this script, for `reap` to re-enter itself. Taken from BASH_SOURCE
# rather than $0 so it stays correct when pp-work is reached via its ~/.local/bin symlink.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# Anchor on the MAIN checkout, never `--show-toplevel`: inside a linked worktree that
# returns the worktree's own path, so the root would differ per workspace.
resolve() {
  local dir="${1:-$PWD}" common
  common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "not inside a git repository: $dir"
  MAIN=$(dirname "$common")
  REPO_NAME=$(basename "$MAIN")
  HASH8=$(echo -n "$MAIN" | shasum -a 256 | cut -c 1-8)
  WS_ROOT="$HOME/kb-scratch/workspaces/$REPO_NAME-$HASH8"
  WT_POOL="$HOME/kb-scratch/worktrees/$REPO_NAME-$HASH8"
  LANDING="$HOME/kb-scratch/landing/$REPO_NAME-$HASH8"
}

# A workspace is clean only if it has NO uncommitted work AND NO generated media.
# Renders are gitignored, so a commit can never carry them — folder persistence is the
# only thing that saves them, which is why ignored media blocks removal forever with no
# TTL. node_modules and the bootstrap symlinks are ignored too and must NOT block.
ws_is_clean() {
  local wt="$1"
  [ -z "$(git -C "$wt" status --porcelain --untracked-files=all 2>/dev/null)" ] || return 1
  local media
  media=$(git -C "$wt" ls-files --others --ignored --exclude-standard 2>/dev/null \
          | grep -Ei '\.(mp4|mov|webm|wav|mp3|m4a|png|jpe?g)$' \
          | grep -v '/node_modules/' | head -1 || true)
  [ -z "$media" ] || return 1
  return 0
}

# Idleness. The manifest's `pid` is pp-work's OWN pid and is dead the moment claim
# returns, so it can never answer "is a session still using this?". `touched` can:
# claim refreshes it, and pp-land refreshes it after every land. A workspace touched
# inside the grace window counts as in use and is never reaped.
#
# Removal ALREADY requires zero uncommitted files, so this window only has to cover the
# gap between a land and the owner's next edit -- the one moment a session sitting in a
# clean, just-landed workspace could have the folder deleted out from under its shell.
PPWORK_GRACE_SECS="${PPWORK_GRACE_SECS:-14400}"   # 4h

ws_touched() {
  local slug_dir="$1" t=""
  if [ -f "$slug_dir/manifest" ]; then
    t=$(sed -n 's/^touched=//p' "$slug_dir/manifest" 2>/dev/null | tail -1 || true)
  fi
  case "$t" in
    ''|*[!0-9]*) t=$(stat -f %m "$slug_dir" 2>/dev/null || stat -c %Y "$slug_dir" 2>/dev/null || date +%s) ;;
  esac
  printf '%s\n' "$t"
}

# Is every change on this branch already on origin/main?
#
# `merge-base --is-ancestor` alone is WRONG here, and silently so. pp-land lands through
# greenlight, which REBASES the branch onto main in the landing tree, so the commits that
# reach main carry new SHAs. The workspace's own branch tip is then not an ancestor of
# main even though every line of it is on main -- measured 2026-08-23 on two live
# workspaces, both fully landed, both reported unmerged. That made removal impossible for
# any workspace that landed after main had moved, i.e. most of them: workspaces would have
# accumulated forever while `reap` reported "not merged" each time.
#
# So compare by patch-id. `git cherry` prints `+` for a commit whose patch is NOT upstream
# and `-` for one that is. No `+` lines means fully applied, however it got there.
# The branch the manifest says this workspace is for, vs the branch HEAD is actually on.
# They diverge when a session runs `checkout -b` inside a workspace (the wall only blocks
# that in the MAIN checkout). The consequence is severe and silent: `post-commit` only fires
# the lander for work/*|subject/*, so every commit on the new branch is unlanded, and
# ws_is_merged then pins the workspace forever. Measured 2026-08-23 on script-desk-plans.
# Are this branch's commits recoverable WITHOUT this folder?
#
# `ws_is_merged` asks "is it on origin/main", which is the right question for a landed
# workspace but the wrong one for a raised plan. `secretary raise` PUSHES the branch and
# opens a boss PR; the commits reach main only when boss merges, which can be days. Until
# then ws_is_merged says no, so the workspace was unreclaimable — measured 2026-08-23 on
# script-desk-plans: 137 MB pinned behind an open PR#196, and every future raise would pin
# another. The commits were never at risk; they were on origin the whole time.
#
# So the refusal test is "exists only here", not "not on main". A tip that matches origin
# is recoverable by anyone with the remote.
ws_is_on_origin() {
  local branch="$1" local_sha remote_sha
  [ -n "$branch" ] || return 1
  local_sha=$(git -C "$MAIN" rev-parse --verify "refs/heads/$branch" 2>/dev/null) || return 1
  remote_sha=$(git -C "$MAIN" ls-remote --heads origin "$branch" 2>/dev/null | awk '{print $1}' | head -1)
  [ -n "$remote_sha" ] || return 1
  [ "$local_sha" = "$remote_sha" ]
}

ws_manifest_branch() {
  local slug_dir="$1"
  [ -f "$slug_dir/manifest" ] || return 0
  sed -n 's/^branch=//p' "$slug_dir/manifest" 2>/dev/null | tail -1 || true
}

# Snapshot refs taken by `pp-work snapshot`. Counted, never dereferenced, in `list`.
ws_snapshot_count() {
  local slug="$1"
  git -C "$MAIN" for-each-ref --format='%(refname)' "refs/pp-work/snap/$slug/" 2>/dev/null \
    | grep -c . || true
}

ws_is_merged() {
  local branch="$1" out rc=0
  git -C "$MAIN" merge-base --is-ancestor "$branch" origin/main 2>/dev/null && return 0
  out=$(git -C "$MAIN" cherry origin/main "$branch" 2>/dev/null) || rc=$?
  [ "$rc" -eq 0 ] || return 1
  printf '%s\n' "$out" | grep -q '^+' && return 1
  return 0
}

# How many commits on this branch are NOT yet on main, by patch-id. Reported by `list` in
# place of a raw `rev-list --count`, which counted rebased-and-landed commits as pending.
ws_unlanded() {
  local branch="$1" out rc=0
  out=$(git -C "$MAIN" cherry origin/main "$branch" 2>/dev/null) || rc=$?
  if [ "$rc" -ne 0 ]; then printf '?\n'; return 0; fi
  printf '%s\n' "$out" | grep -c '^+' || true
}

ws_is_idle() {
  local slug_dir="$1" t now
  t=$(ws_touched "$slug_dir")
  now=$(date +%s)
  [ "$((now - t))" -ge "$PPWORK_GRACE_SECS" ]
}

# APPEND, never rewrite in place -- the same convention boss-lib.sh's meta_set uses, and
# every reader here takes `tail -1`. A partial in-place rewrite would strand the manifest,
# and a stranded manifest reads as untouched, which is to say reapable.
ws_set_touched() {
  local slug_dir="$1"
  [ -f "$slug_dir/manifest" ] || return 0
  printf 'touched=%s\n' "$(date +%s)" >> "$slug_dir/manifest"
  return 0
}

if [ $# -eq 0 ]; then
  die "Usage: pp-work <claim|list|remove|reap|snapshot|touch> ..."
fi

cmd="$1"
shift

case "$cmd" in
  claim)
    kind=""
    slug=""
    task=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --kind) kind="$2"; shift 2 ;;
        --slug) slug="$2"; shift 2 ;;
        --task) task="$2"; shift 2 ;;
        *) die "unknown arg: $1" ;;
      esac
    done
    [ -n "$kind" ] && [ -n "$slug" ] || die "usage: claim --kind <code|subject> --slug <slug> [--task <text>]"
    [[ "$kind" == "code" || "$kind" == "subject" ]] || die "kind must be code or subject"

    resolve

    [[ "$slug" =~ ^[a-z0-9._/-]+$ ]] || die "invalid slug format"
    [[ "$slug" == *..* ]] && die "slug cannot contain .."

    wt_path="$WS_ROOT/$slug/$REPO_NAME"
    if [[ "$wt_path" == "$MAIN/"* || "$wt_path" == "$MAIN" ]]; then
      die "refusing to create workspace under main checkout"
    fi
    if [[ "$wt_path" == "$WT_POOL/"* || "$wt_path" == "$WT_POOL" ]]; then
      die "refusing to create workspace under WT_POOL"
    fi
    if [[ "$wt_path" == "$LANDING/"* || "$wt_path" == "$LANDING" ]]; then
      die "refusing to create workspace under LANDING"
    fi

    if [ -d "$wt_path" ]; then
      # Re-claiming an existing workspace means a session is picking the work back up.
      # That is exactly the signal the reaper needs in order to leave it alone.
      ws_set_touched "$WS_ROOT/$slug"
      echo "$wt_path"
      exit 0
    fi

    avail_kb=$(df -k "$HOME" | awk 'NR==2 {print $4}')
    if [ "$avail_kb" -lt 10485760 ]; then
      echo "pp-work: WARNING: Under 10 GiB available on \$HOME. See pp-work list." >&2
    fi

    if [ "$kind" = "subject" ]; then
      branch="subject/$slug"
    else
      branch="work/$slug"
    fi

    mkdir -p "$WS_ROOT/$slug"

    if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$branch"; then
      if ! git -C "$MAIN" worktree add "$wt_path" "$branch" >&2; then
        holding=$(git -C "$MAIN" worktree list --porcelain | grep -B2 "branch refs/heads/$branch" | awk '/^worktree/ {print $2}')
        die "branch $branch is checked out elsewhere: $holding. Read-only inspection is available there."
      fi
    else
      if ! git -C "$MAIN" worktree add "$wt_path" -b "$branch" >&2; then
        holding=$(git -C "$MAIN" worktree list --porcelain | grep -B2 "branch refs/heads/$branch" | awk '/^worktree/ {print $2}' || echo "unknown")
        die "branch $branch is checked out elsewhere: $holding. Read-only inspection is available there."
      fi
    fi

    if [ -f "$MAIN/tooling/cli/wt/bootstrap.d/$REPO_NAME.sh" ]; then
      ( cd "$wt_path" && WT_MAIN_CHECKOUT="$MAIN" bash "$MAIN/tooling/cli/wt/bootstrap.d/$REPO_NAME.sh" ) || true
    fi

    cat > "$WS_ROOT/$slug/manifest" <<EOF
kind=$kind
slug=$slug
branch=$branch
session=${CLAUDE_SESSION_ID:-unknown}
pid=$$
task=$task
created=$(date +%s)
touched=$(date +%s)
main=$MAIN
EOF

    if [ -d "$MAIN/tooling/boss/state/lands" ]; then
      blocked_count=$(find "$MAIN/tooling/boss/state/lands" -maxdepth 1 -name "*.blocked" 2>/dev/null | wc -l | tr -d ' ')
      if [ "$blocked_count" -gt 0 ]; then
        echo "pp-work: ${blocked_count} blocked land(s) waiting — see pp-work list" >&2
      fi
    fi

    echo "$wt_path"
    ;;

  list)
    dirty_only=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --dirty) dirty_only=1; shift ;;
        *) die "unknown arg: $1" ;;
      esac
    done
    resolve

    echo "--- Workspaces ---"
    if [ -d "$WS_ROOT" ]; then
      for slug_dir in "$WS_ROOT"/*; do
        [ -d "$slug_dir" ] || continue
        slug=$(basename "$slug_dir")
        wt_path="$slug_dir/$REPO_NAME"
        if [ ! -d "$wt_path" ]; then
          continue
        fi

        # `list` is the only screen showing which workspaces exist, their disk use and
        # the blocked lands, so ONE bad workspace must never hide the rest -- the
        # media-probe pipefail bug hid a whole workspace behind a single exit 1.
        #
        # The guarantee comes from the explicit fallback on EVERY fallible command below,
        # not from this subshell. Bash suppresses errexit for a command on the left of
        # `||` (and re-setting `set -e` inside does not clear that), so the body always
        # runs to the end; the subshell only scopes the variables and catches an explicit
        # non-zero return. An unguarded failure would therefore print a row with blank
        # fields, which is worse than crashing -- hence the fallbacks.
        (
          kind="unknown"
          if [ -f "$slug_dir/manifest" ]; then
            kind=$(sed -n 's/^kind=//p' "$slug_dir/manifest" | tail -1 || true)
            [ -n "$kind" ] || kind="unknown"
          fi
          touched=$(ws_touched "$slug_dir")

          now=$(date +%s)
          age_sec=$((now - touched))
          age_days=$((age_sec / 86400))

          branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
          [ -n "$branch" ] || branch="unknown"
          unlanded=$(ws_unlanded "$branch" || true)
          [ -n "$unlanded" ] || unlanded="?"
          uncommitted=$(git -C "$wt_path" status --porcelain --untracked-files=all 2>/dev/null | wc -l | tr -d ' ' || true)
          [ -n "$uncommitted" ] || uncommitted="?"

          media="no"
          media_found=$(git -C "$wt_path" ls-files --others --ignored --exclude-standard 2>/dev/null \
            | grep -Ei '\.(mp4|mov|webm|wav|mp3|m4a|png|jpe?g)$' \
            | grep -v '/node_modules/' | head -1 || true)
          [ -n "$media_found" ] && media="yes"

          size=$(du -sh "$slug_dir" 2>/dev/null | awk '{print $1}' || true)
          [ -n "$size" ] || size="?"

          mbranch=$(ws_manifest_branch "$slug_dir" || true)
          mismatch=""
          if [ -n "$mbranch" ] && [ -n "$branch" ] && [ "$branch" != "unknown" ] \
             && [ "$mbranch" != "$branch" ]; then
            mismatch=" | BRANCH-MISMATCH manifest:$mbranch"
          fi
          snaps=$(ws_snapshot_count "$slug" || true)
          [ -n "$snaps" ] || snaps=0

          # --dirty keeps only rows that need a human: uncommitted work, commits that have
          # not reached main, a branch that will never land, or a rescue snapshot.
          if [ "$dirty_only" -eq 1 ]; then
            case "$uncommitted$unlanded$snaps$mismatch" in
              000) exit 0 ;;
            esac
          fi

          echo "$slug | kind:$kind | branch:$branch | age:${age_days}d | unlanded:$unlanded | uncommitted:$uncommitted | media:$media | snaps:$snaps | size:$size$mismatch"
          echo "  cd $wt_path"
        ) || echo "$slug | UNREADABLE (could not inspect) | cd $wt_path"
      done
    fi

    if [ -d "$LANDING" ]; then
      landing_size=$(du -sh "$LANDING" 2>/dev/null | awk '{print $1}')
      echo "--- Landing ---"
      echo "Size: $landing_size"
    fi

    echo "--- WT Pool ---"
    if [ -x "$MAIN/tooling/cli/wt/wt" ]; then
      "$MAIN/tooling/cli/wt/wt" status --repo "$MAIN"
    elif command -v wt >/dev/null 2>&1; then
      wt status --repo "$MAIN"
    fi

    sz_ws=$( [ -d "$WS_ROOT" ] && du -sk "$WS_ROOT" 2>/dev/null | awk '{print $1}' || echo 0 )
    sz_pool=$( [ -d "$WT_POOL" ] && du -sk "$WT_POOL" 2>/dev/null | awk '{print $1}' || echo 0 )
    sz_land=$( [ -d "$LANDING" ] && du -sk "$LANDING" 2>/dev/null | awk '{print $1}' || echo 0 )
    total_kb=$((sz_ws + sz_pool + sz_land))
    total_mb=$((total_kb / 1024))

    avail_kb=$(df -k "$HOME" | awk 'NR==2 {print $4}')
    avail_gb=$((avail_kb / 1024 / 1024))

    echo "--- Summary ---"
    echo "Total size: ${total_mb} MB | Available disk: ${avail_gb} GB"

    if [ -d "$MAIN/tooling/boss/state/lands" ]; then
      blocked=$(ls -1 "$MAIN/tooling/boss/state/lands"/*.blocked 2>/dev/null || true)
      if [ -n "$blocked" ]; then
        echo "--- Blocked Lands ---"
        echo "$blocked"
      fi
    fi
    ;;

  remove)
    force_now=0
    wt=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --now) force_now=1; shift ;;
        -*) die "unknown arg: $1" ;;
        *) [ -z "$wt" ] || die "unexpected extra argument: $1"; wt="${1%/}"; shift ;;
      esac
    done
    [ -n "$wt" ] || die "usage: remove <path> [--now]"
    resolve "$wt"

    if ! ws_is_clean "$wt"; then
      die "PPWORK-DIRTY refusing to remove $wt — it holds uncommitted work or generated media.
  Inspect it with: pp-work list
  There is no TTL and no automatic reclaim; this workspace stays until you deal with it."
    fi
    branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD)
    if ! ws_is_merged "$branch"; then
      if ws_is_on_origin "$branch"; then
        echo "pp-work: '$branch' is not on origin/main, but its tip matches origin — the commits are recoverable without this folder." >&2
      else
        die "PPWORK-UNMERGED refusing to remove $wt — branch '$branch' has commits that are neither on origin/main nor pushed to origin. They exist ONLY here."
      fi
    fi
    
    # The idle gate. A land does NOT mean the owner's work is over -- a session commits
    # many times into one workspace -- so a clean, merged, just-landed workspace must keep
    # its folder, or the session's own shell loses its cwd mid-task. It is reclaimed later
    # by `reap`, once untouched for the grace window. `--now` is the explicit override,
    # and it is what `reap` uses after making the same check itself.
    if [ "$force_now" -eq 0 ] && ! ws_is_idle "$(dirname "$wt")"; then
      die "PPWORK-ACTIVE refusing to remove $wt — it was used under $((PPWORK_GRACE_SECS / 60)) min ago, so a session may still be working in it.
  It is clean and merged, so 'pp-work reap' will reclaim it once it goes idle.
  To remove it right now anyway: pp-work remove $wt --now"
    fi

    git -C "$MAIN" worktree remove "$wt"
    
    parent_dir=$(dirname "$wt")
    if [ -d "$parent_dir" ]; then
      rm -rf "$parent_dir"
    fi
    ;;

  reap)
    # The cleanup path, and the catch-up too: it runs from boss-session-start, so a
    # workspace whose session died is reclaimed the next time boss opens. Each gate is
    # checked here only to REPORT why a workspace is kept; the deletion itself goes
    # through `remove --now`, so this tool keeps exactly ONE deletion path and reap
    # cannot drift away from remove's gates.
    resolve
    reaped=0
    kept=0
    if [ -d "$WS_ROOT" ]; then
      for slug_dir in "$WS_ROOT"/*; do
        [ -d "$slug_dir" ] || continue
        slug=$(basename "$slug_dir")
        wt_path="$slug_dir/$REPO_NAME"
        [ -d "$wt_path" ] || continue

        if ! ws_is_idle "$slug_dir"; then
          kept=$((kept + 1)); echo "pp-work: keep $slug — in use (touched inside the grace window)"; continue
        fi
        if ! ws_is_clean "$wt_path"; then
          kept=$((kept + 1)); echo "pp-work: keep $slug — uncommitted work or generated media"; continue
        fi
        branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
        mbranch=$(ws_manifest_branch "$slug_dir" || true)
        if [ -n "$mbranch" ] && [ -n "$branch" ] && [ "$mbranch" != "$branch" ]; then
          # A NOTE, not a refusal. The safety test below is what protects work; refusing on
          # the mismatch alone pinned a workspace forever even when its commits were safely
          # on origin, which is exactly the PR#196 case this rule was added for.
          echo "pp-work: note $slug — HEAD is [$branch], manifest says [$mbranch]; the lander never fires for that branch."
        fi
        if [ -z "$branch" ]; then
          kept=$((kept + 1)); echo "pp-work: keep $slug — cannot read its branch"; continue
        fi
        if ! ws_is_merged "$branch" && ! ws_is_on_origin "$branch"; then
          kept=$((kept + 1)); echo "pp-work: keep $slug — branch [$branch] has commits that exist ONLY here (not on origin/main, not pushed)"; continue
        fi
        if "$SELF" remove "$wt_path" --now >/dev/null 2>&1; then
          reaped=$((reaped + 1)); echo "pp-work: reaped $slug"
        else
          kept=$((kept + 1)); echo "pp-work: keep $slug — remove refused it"
        fi
      done
    fi
    echo "pp-work: reap done — $reaped reclaimed, $kept kept"
    ;;

  snapshot)
    # Record a workspace's tree WITHOUT committing it. Usage: snapshot <path> | snapshot --all
    #
    # Why not a commit: in this system a commit inside a workspace IS a trigger — the
    # post-commit hook fires pp-land, which rebases, verifies and pushes to main. So there
    # is no such thing as a private rescue commit here; a "just in case" commit ships
    # unreviewed code to production, and the VPS pulls this repo every 15 minutes.
    #
    # `stash create` writes a commit OBJECT and changes nothing else: no index write, no
    # working-tree change, no branch reflog entry. A live session sees no interference.
    # `update-ref` under a private namespace makes it permanent (unlike the stash stack,
    # which any later stash churns) and fires no hook.
    #
    # Recover with:  git -C <workspace> stash apply <ref>    (or: git diff HEAD <ref>)
    resolve
    # Built on a THROWAWAY index, not with `stash create`. `stash create` records tracked
    # modifications only, and a brand-new untracked file is the single most likely thing to
    # lose — measured while building this: the first implementation silently omitted two new
    # hook files. read-tree + add -A + write-tree against GIT_INDEX_FILE captures tracked
    # AND untracked (still honouring .gitignore, so renders and node_modules stay out), and
    # touches neither the real index, the working tree, the stash stack, nor any branch.
    # commit-tree writes a commit object directly, so no hook fires.
    snap_one() {
      local wt="$1" slug="$2" idx tree obj
      [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ] || return 1
      idx=$(mktemp -t ppwork-snap-idx) || return 1
      rm -f "$idx"
      if ! GIT_INDEX_FILE="$idx" git -C "$wt" read-tree HEAD 2>/dev/null; then
        rm -f "$idx"; return 1
      fi
      if ! GIT_INDEX_FILE="$idx" git -C "$wt" add -A 2>/dev/null; then
        rm -f "$idx"; return 1
      fi
      tree=$(GIT_INDEX_FILE="$idx" git -C "$wt" write-tree 2>/dev/null)
      rm -f "$idx"
      [ -n "$tree" ] || return 1
      obj=$(git -C "$wt" commit-tree "$tree" -p HEAD \
              -m "pp-work snapshot: $slug (uncommitted rescue, never landed)" 2>/dev/null) || return 1
      [ -n "$obj" ] || return 1
      git -C "$MAIN" update-ref "refs/pp-work/snap/$slug/$(date +%s)" "$obj" || return 1
      return 0
    }
    if [ "${1:-}" = "--all" ]; then
      taken=0
      for slug_dir in "$WS_ROOT"/*; do
        [ -d "$slug_dir" ] || continue
        slug=$(basename "$slug_dir")
        wt_path="$slug_dir/$REPO_NAME"
        [ -d "$wt_path" ] || continue
        if snap_one "$wt_path" "$slug"; then
          taken=$((taken + 1))
          echo "pp-work: snapshot taken for $slug (refs/pp-work/snap/$slug/)"
        fi
      done
      echo "pp-work: snapshot done — $taken taken"
    else
      [ $# -ge 1 ] || die "usage: snapshot <path> | snapshot --all"
      wt="${1%/}"
      resolve "$wt"
      slug=$(basename "$(dirname "$wt")")
      if snap_one "$wt" "$slug"; then
        echo "pp-work: snapshot taken for $slug"
      else
        echo "pp-work: nothing to snapshot for $slug (tree is clean)"
      fi
    fi
    ;;

  touch)
    # Called by pp-land after every land: a land is activity, not completion.
    [ $# -ge 1 ] || die "usage: touch <path>"
    wt="${1%/}"
    resolve "$wt"
    ws_set_touched "$(dirname "$wt")"
    ;;

  *)
    die "unknown command: $cmd"
    ;;
esac
