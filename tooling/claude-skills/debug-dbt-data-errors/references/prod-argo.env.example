# COPY THIS TO prod-argo.env AND FILL IN. prod-argo.env is gitignored and must
# NEVER be committed: this repo is public. Get ARGO_TOKEN from the cluster, not from git.
# Prod be-dbt Argo Workflows access (used by scripts/argo-logs.sh)
# The token is a long-lived Kubernetes ServiceAccount token, namespace-scoped
# to ARGO_NS: it can read/list
# workflows and read archived-workflow + artifact logs in ARGO_NS only.
# (The cluster-scoped archived-workflows list endpoint returns 403 for it.)

ARGO_BASE=
ARGO_NS=
ARGO_TOKEN=
