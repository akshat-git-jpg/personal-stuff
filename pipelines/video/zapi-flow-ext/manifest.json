{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "ZAPI FLOW (Arc)",
  "version": "1.2.3",
  "description": "Queue prompts for bulk image generation on Google Flow (labs.google/fx/tools/flow).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel", "unlimitedStorage", "scripting", "downloads", "tabs"],
  "host_permissions": [
    "https://labs.google/fx/*",
    "http://127.0.0.1:4399/*",
    "http://localhost:4399/*"
  ],
  "action": {
    "default_title": "ZAPI FLOW",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+Z", "mac": "Alt+Shift+Z" },
      "description": "Open the ZAPI FLOW panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/fx/*"],
      "js": ["selectors.js", "content.js", "arc-launcher.js"],
      "run_at": "document_idle"
    }
  ]
}
