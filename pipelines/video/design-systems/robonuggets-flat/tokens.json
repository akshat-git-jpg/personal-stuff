{
  "name": "robonuggets-flat",
  "color": {
    "paper": "#eeece0",
    "mustard": "#ecbf35",
    "cobalt": "#2b2bd6",
    "ink": "#17161a",
    "signal": "#d93333",
    "amber": "#e9a03c",
    "chalk": "#f6f4ec",
    "plane-shade": "#b9b6e8",
    "footer-ink": "#17161a"
  },
  "font": {
    "display": "\"Inter\", \"Helvetica Neue\", Arial, sans-serif",
    "body": "\"Inter\", \"Helvetica Neue\", Arial, sans-serif",
    "mono": "\"JetBrains Mono\", \"SFMono-Regular\", Menlo, monospace"
  },
  "type": {
    "title": { "sizeVh": 6, "weight": 700, "tracking": "0em", "case": "none" },
    "footerLabel": { "sizeVh": 2.6, "weight": 700, "tracking": "0em", "case": "none" },
    "footerSub": { "sizeVh": 2, "weight": 400, "tracking": "0.02em", "case": "none" },
    "footerIndex": { "sizeVh": 1.8, "weight": 400, "tracking": "0.02em", "case": "none" }
  },
  "space": { "marginPct": 4, "gapPct": 4 },
  "radius": { "tip": "3px", "circle": "50%", "none": "0px" },
  "shadow": {
    "contact": "0 0.6vh 1.2vh rgba(23, 22, 26, 0.3)",
    "card": "none"
  },
  "stroke": { "dashedPath": 2, "dash": 6, "gap": 6 },
  "ease": {
    "flood": "cubic-bezier(0.7, 0, 0.3, 1)",
    "morph": "cubic-bezier(0.65, 0, 0.35, 1)",
    "wipe": "cubic-bezier(0.6, 0, 0.4, 1)",
    "out": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "duration": {
    "flood": 400,
    "morph": 300,
    "wipe": 400,
    "travel": 400,
    "blurFrames": 100
  },
  "motion": { "holdMs": 3000, "transition": "soft-edged colour flood or wavy wipe with hero morph" }
}
