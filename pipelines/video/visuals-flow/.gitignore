# per-video media is regenerable / hub-bound — text artifacts ARE committed
videos/*/vo.mp3
# the intro-only cut of vo.mp3, fed to the avatar render for an intro film
videos/*/intro-vo.mp3
# the ONE avatar clip an intro film composes against. It is a HeyGen render, so
# it is generated media like every other render and never belongs in the repo —
# 24MB of it was committed by mistake on 2026-08-03 before this line existed.
videos/*/avatar.mp4
videos/*/renders/
videos/*/renders.run*/
videos/*/renders-fx/
videos/*/renders-fx.run*/
videos/*/slices/
videos/*/slices-avatar/
videos/*/screen.mp4
videos/*/assembly-tmp/
videos/*/assembly-cache/
videos/*/render-cache/
# test artifacts
lib/.test-tmp/
lib/fixtures/board/vo.mp3
lib/fixtures/board/slices/
.DS_Store
# raw source video segments per test/video — never committed
videos/*/src/
assets/sfx/*.wav
videos/*/master.wav
videos/*/music-ducked.wav
videos/*/sfx-bus.wav
videos/*/*.full.mp4
videos/*/*.full.mp3
videos/*/versions.run*/
videos/*/versions.run*.json
videos/*/feedback-images/
# per-video generated card art (pollinations portraits and the like). Generated
# media, so it follows the same rule as renders: regenerable, never committed.
videos/*/card-images/
board-ui/node_modules/
board-ui/dist/
.test-tmp/
debug-*.mjs
test-*.mjs
videos/*/intro-film/film/assets/
videos/*/intro-film/review/
videos/*/intro-film/renders/
videos/*/intro-film/out/

# The SIMPLE intro flow's generated media (plan 220). Same rule as the film
# folder above, and it needed its own lines because intro-simple/ matched none
# of them: the first real simple intro left 45MB of clips untracked, which a
# `git add -A` would have swept straight into a commit. cutlist.json and
# render.json are the RECORD of the cut and stay committed; the mp4s beside them
# all reappear from `run.sh <slug> intro-simple-render`.
videos/*/intro-simple/renders/
videos/*/intro-simple/render-cache/
videos/*/intro-simple/stand-in-avatar.mp4

# Generated review output, both cut from renders/ which is already ignored.
# .posters/ is JPEGs ffmpeg cuts on demand for the Storyboard tiles; checks/ is
# the machine-readable report each -run review step writes. Neither is input to
# anything and both reappear on the next run (gap found 2026-08-07).
videos/*/.posters/
videos/*/checks/

# Archived review/film snapshots. The TEXT record inside (REVIEW.md, check.json)
# is the point of an archive and stays committed; the frames and cuts beside it
# are the same generated media as review/ and out/, just moved aside — a 36MB
# intro mp4 and 59 frame PNGs turned up untracked on 2026-08-20 because the
# archive path matched none of the rules above.
videos/*/intro-film/archive/**/*.png
videos/*/intro-film/archive/**/*.jpg
videos/*/intro-film/archive/*.mp4

# The intro-only VO cut the film previews against — same generated audio as
# vo.mp3 and intro-vo.mp3 above, just written under the film folder.
videos/*/intro-film/film/preview-vo.mp3
