# Secrets — never commit these
**/secrets/*
**/.env
**/credentials.json
**/token.json
**/token_*.json
**/service_account.json
**/google-shared/tokens/

# ...except checked-in templates for owner-filled secrets
!infra/secrets/*.example

# Local MCP config — paths inside are absolute to this machine, so
# committing would break other clones. Each machine generates its own
# from ~/.claude-personal/.claude.json's mcpServers block.
.mcp.json
# ...except test fixtures, which are tiny, path-free, and required by the
# ccusage-dashboard workspace scanner tests.
!tooling/cli/ccusage-dashboard/test/fixtures/**/.mcp.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
*.egg-info/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local Claude permission overrides and per-session worktrees.
# These were previously protected ONLY by .git/info/exclude (lines 11 and 18), which is
# per-clone and machine-local — so a fresh clone or the VPS had no protection at all, on a
# PUBLIC repo, for a file that holds a live GH_TOKEN and is rewritten by Claude Code on
# every permission save. The old note here said settings.local.json was "allowed"; nothing
# is or was tracked (`git ls-files | grep settings.local.json` is empty), so ignoring it
# costs nothing. If a specific override file is ever genuinely wanted in git, add it by
# name with `git add -f`.
.claude/settings.local.json
.claude/worktrees/
.claude/cache/
.claude/logs/

# Backup files from edits
*.bak
*.bak-*

# Build / coverage artifacts (in case any of the MCPs ever grow these)
build/
dist/
.coverage
htmlcov/
.pytest_cache/

# stray test-run captures (crews sometimes redirect check.sh output to repo root)
test-output*.log

# IDE
.idea/
.vscode/

# ntfy runtime data — caches, attachments, user db (server.yml is checked in)
infra/docker/ntfy/data/cache/
infra/docker/ntfy/data/etc/users.db

# Rendered/generated media — outputs are rebuildable, never commit
pipelines/video/voice/**/output/
# The tree moved under archive/ and this rule did not follow, so it matched nothing and
# 37 rendered files are already tracked beneath it. Both spellings are kept: the archive
# path is where the files actually live, the original is harmless and covers a restore.
pipelines/archive/hyperframes-vs-remotion/yt-visuals/cutaways/**/*.mp4
pipelines/archive/hyperframes-vs-remotion/yt-visuals/cutaways/**/*.webm
pipelines/hyperframes-vs-remotion/yt-visuals/cutaways/**/*.mp4
pipelines/hyperframes-vs-remotion/yt-visuals/cutaways/**/*.webm
docs/voice-pipeline-test/

# Node dependencies — never commit
node_modules/

# secrets escrow — never commit archives (script writes to TMPDIR, this is a guard)
infra/escrow/*.gpg
infra/escrow/*.tar.gz
infra/escrow/out/

# work credentials — this repo is PUBLIC. Skills must ship a *.env.example only,
# never a real *.env (see decisions.md 2026-08-03).
tooling/claude-skills/*/references/*.env
!tooling/claude-skills/*/references/*.env.example

# Generated flow diagrams. Self-contained HTML with the data inlined, so each one
# is megabytes — tutorial-tracker-flow.html alone is 2.2 MB, over pp-push's 1 MB
# cap. Rebuildable, and this repo is PUBLIC. Regenerate rather than commit.
apps/*/docs/flow/*.html
