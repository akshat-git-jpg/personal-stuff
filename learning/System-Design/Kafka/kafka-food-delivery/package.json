{
  "name": "kafka-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A free local Kafka lab. Learn Kafka by running it, watching it, and breaking it.",
  "scripts": {
    "up": "docker compose up -d && echo '\\nDashboard: http://localhost:8080'",
    "down": "docker compose stop",
    "reset": "docker compose down && docker compose up -d",
    "logs": "docker compose logs -f kafka",

    "topics:create": "tsx src/lib/topics.ts create",
    "topics:list": "tsx src/lib/topics.ts list",
    "topics:describe": "tsx src/lib/topics.ts describe",
    "topics:nuke": "tsx src/lib/topics.ts nuke",

    "ch1:produce": "tsx src/01-hello/produce.ts",
    "ch1:consume": "tsx src/01-hello/consume.ts",

    "ch2:produce": "tsx src/02-partitions/produce.ts",
    "ch2:consume": "tsx src/02-partitions/consume.ts",

    "ch3:produce": "tsx src/03-consumer-groups/produce.ts",
    "ch3:consume": "tsx src/03-consumer-groups/consume.ts",

    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
