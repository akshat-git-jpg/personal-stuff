    {
      "id": "el-563",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 80,
      "y": 3618,
      "width": 845.6000000000001,
      "height": 12.5,
      "text": "Someone copy-pasted the groupId. They are now ONE group, so the partitions get SPLIT between them — the kitchen silently never sees partitions 1 and 3.",
      "originalText": "Someone copy-pasted the groupId. They are now ONE group, so the partitions get SPLIT between them — the kitchen silently never sees partitions 1 and 3.",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-564",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 710,
      "y": 3324,
      "width": 392.00000000000006,
      "height": 140,
      "text": "Scenario 9 is the most common Kafka bug in real\ncompanies.\n\ngroupId is not a label. It is the thing Kafka uses\nto decide WHO COMPETES WITH WHOM.\n\nTwo services that must BOTH see every message\nneed two DIFFERENT groupIds. Always.",
      "originalText": "Scenario 9 is the most common Kafka bug in real\ncompanies.\n\ngroupId is not a label. It is the thing Kafka uses\nto decide WHO COMPETES WITH WHOM.\n\nTwo services that must BOTH see every message\nneed two DIFFERENT groupIds. Always.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-565",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "rectangle",
      "x": 60,
      "y": 3714,
      "width": 1280,
      "height": 190
    },
    {
      "id": "el-566",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 82,
      "y": 3732,
      "width": 181.44000000000003,
      "height": 22.5,
      "text": "Remember only this",
      "originalText": "Remember only this",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-567",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 82,
      "y": 3772,
      "width": 917.2800000000001,
      "height": 35,
      "text": "INSIDE one group   ->  every PARTITION has exactly ONE owner, so every message in it is handled once by that team.\nACROSS groups      ->  nothing is shared. Every group gets its own full copy of every message, with its own bookmark.",
      "originalText": "INSIDE one group   ->  every PARTITION has exactly ONE owner, so every message in it is handled once by that team.\nACROSS groups      ->  nothing is shared. Every group gets its own full copy of every message, with its own bookmark.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-568",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 82,
      "y": 3846,
      "width": 880.32,
      "height": 15,
      "text": "Kafka assigns PARTITIONS, never individual messages. Hold that one sentence and all nine cards above stop being things to memorise.",
      "originalText": "Kafka assigns PARTITIONS, never individual messages. Hold that one sentence and all nine cards above stop being things to memorise.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
