      "type": "text",
      "x": 82,
      "y": 2218,
      "width": 181.44000000000003,
      "height": 22.5,
      "text": "Remember only this",
      "originalText": "Remember only this",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
