      "locked": false,
      "type": "text",
      "x": 82,
      "y": 1208,
      "width": 171.36,
      "height": 21.25,
      "text": "Remember only this",
      "originalText": "Remember only this",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-131",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 82,
      "y": 1244,
      "width": 791.84,
      "height": 35,
      "text": "INSIDE one group   ->  each partition has exactly ONE owner.  A message is handled once by that team.\nACROSS groups      ->  nothing is shared.  Every group gets its own full copy of every message.",
      "originalText": "INSIDE one group   ->  each partition has exactly ONE owner.  A message is handled once by that team.\nACROSS groups      ->  nothing is shared.  Every group gets its own full copy of every message.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-132",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 82,
      "y": 1300,
      "width": 692.1600000000001,
      "height": 15,
      "text": "Kafka assigns partitions, not messages. Once you hold that sentence, all eight cards above are obvious.",
      "originalText": "Kafka assigns partitions, not messages. Once you hold that sentence, all eight cards above are obvious.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
