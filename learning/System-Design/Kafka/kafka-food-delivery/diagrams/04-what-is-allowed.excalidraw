      "type": "text",
      "x": 720,
      "y": 1110,
      "width": 634.48,
      "height": 13.75,
      "text": "Not an error message, just broken behaviour. Every member of a group must subscribe to the same topics.",
      "originalText": "Not an error message, just broken behaviour. Every member of a group must subscribe to the same topics.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-129",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#1e1e1e",
