      "type": "text",
      "x": 60,
      "y": 440,
      "width": 672.0000000000001,
      "height": 60,
      "text": "Reading does NOT delete. The message stays at its offset.\nThe bookmark lives on the BROKER, not on the tablet.\nSo the tablet can die mid-shift, come back, and resume at exactly offset 5.",
      "originalText": "Reading does NOT delete. The message stays at its offset.\nThe bookmark lives on the BROKER, not on the tablet.\nSo the tablet can die mid-shift, come back, and resume at exactly offset 5.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
