      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 82,
      "y": 654,
      "width": 813.1200000000001,
      "height": 30,
      "text": "HOLDS 3 partitions.       Kafka assigns whole partitions, never single messages.\n                          Alone in its group, one consumer owns every partition. That is the default, not a special case.",
      "originalText": "HOLDS 3 partitions.       Kafka assigns whole partitions, never single messages.\n                          Alone in its group, one consumer owns every partition. That is the default, not a special case.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-73",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 82,
      "y": 706,
      "width": 705.6,
      "height": 30,
      "text": "PROCESSES 1 at a time.    It is one thread. Holding three partitions does NOT make it three times faster.\n                          Want 3x throughput? Run 3 processes. Not a bigger batch, not a bigger laptop.",
      "originalText": "PROCESSES 1 at a time.    It is one thread. Holding three partitions does NOT make it three times faster.\n                          Want 3x throughput? Run 3 processes. Not a bigger batch, not a bigger laptop.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-74",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 82,
      "y": 764,
      "width": 840.0000000000001,
      "height": 15,
      "text": "And this is why order looks jumbled: the batch arrives A1 B1 A2 C1 ... Inside one partition A1 -> A2 -> A3 is always perfect.",
      "originalText": "And this is why order looks jumbled: the batch arrives A1 B1 A2 C1 ... Inside one partition A1 -> A2 -> A3 is always perfect.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
