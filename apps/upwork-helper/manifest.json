{
  "manifest_version": 3,
  "name": "Upwork Helper",
  "version": "1.1.0",
  "description": "Shows the job description Upwork's own API already sent, where the UI prints 'This job is private'.",
  "host_permissions": ["*://*.upwork.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.upwork.com/*"],
      "js": ["helper.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.upwork.com/*"],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["helper.js"],
      "matches": ["*://*.upwork.com/*"]
    }
  ]
}
