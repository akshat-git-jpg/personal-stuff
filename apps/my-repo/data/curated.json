    {
      "scope": "work",
      "name": "Ship & review",
      "blurb": "Branch to merge: PRs, builds, feature envs, prod queries",
      "match": "(ship-feature$|pr-review|build-gate|feature-deploy|commit-now-work|submit-query|zluri-release)"
    },
    {
      "scope": "work",
      "name": "Testing & debug",
      "blurb": "UI tests, API tests, debugging a Zluri system",
      "match": "(testing|debug)"
    },
    {
      "scope": "work",
      "name": "Docs & notes",
      "blurb": "Module docs, feature docs, session learnings",
      "match": "(doc|close-session)"
