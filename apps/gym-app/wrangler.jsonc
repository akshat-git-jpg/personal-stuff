{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kushal-gym",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "kushal-gym.agrolloo.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": { "crons": ["0 4 * * 1"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "gym-db", "database_id": "ceb05b83-8813-4dd2-bd23-e3b37c018e1c" }
  ],
  "observability": {
    "enabled": true
  },
  // A friend's copy: same code, her own Worker, DB and PIN. No Sheets mirror cron.
  // Build with CLOUDFLARE_ENV=sparkly (npm run deploy:sparkly).
  "env": {
    "sparkly": {
      "name": "sparkly-poop-gym",
      "routes": [{ "pattern": "sparkly-poop.agrolloo.com", "custom_domain": true }],
      "triggers": { "crons": [] },
      "vars": { "APP_NAME": "Sparkly" },
      "d1_databases": [
        { "binding": "DB", "database_name": "sparkly-gym-db", "database_id": "507e50ed-57f7-4530-ae3c-71f8fb2ef26e" }
      ]
    }
  }
  // Secrets (set via `wrangler secret put` or .dev.vars for local):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN,
  //   SHEET_ID, APP_PIN, SESSION_SECRET
}
