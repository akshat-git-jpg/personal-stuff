{
  "name": "gym-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": ". ../../scripts/node22-path.sh && vite",
    "build": ". ../../scripts/node22-path.sh && tsc -b && vite build",
    "typecheck": ". ../../scripts/node22-path.sh && tsc -b",
    "preview": ". ../../scripts/node22-path.sh && vite preview",
    "deploy": ". ../../scripts/node22-path.sh && npm run build && node scripts/patch-routes.mjs && wrangler deploy",
    "shoot": "node scripts/shoot.mjs",
    "test": ". ../../scripts/node22-path.sh && vitest run",
    "db:local": ". ../../scripts/node22-path.sh && wrangler d1 execute gym-db --local --file=./schema.sql",
    "db:remote": ". ../../scripts/node22-path.sh && wrangler d1 execute gym-db --remote --file=./schema.sql",
    "seed:local": ". ../../scripts/node22-path.sh && wrangler d1 execute gym-db --local --file=./seed.sql",
    "seed:remote": ". ../../scripts/node22-path.sh && wrangler d1 execute gym-db --remote --file=./seed.sql",
    "export:sheet": "node scripts/export-sheet-to-sql.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.12",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.9",
    "wrangler": "^3.99.0"
  }
}
