# Bark device URL. Get it from the Bark app on your iPhone: its home screen
# shows a URL of the form https://api.day.app/<your-device-key>/. Copy that
# whole URL into the value below.
BARK_URL=

# Name of the sound to play. "alarm" is a loud built-in default. Once you
# upload your own .caf/.wav/.aiff to the Bark app, use its filename here.
BARK_SOUND=alarm

# Timezone for interpreting event times. IANA tz name.
TIMEZONE=Asia/Kolkata

# Google Calendar id to watch. "primary" = the account's default calendar.
CALENDAR_ID=primary

# Optional Telegram fallback that echoes the routine name so you have a
# scrollable log. Leave blank to skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
